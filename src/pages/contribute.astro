---
import Base from '../layouts/Base.astro';

const TASKLIST = 'https://jfk-1.tasklist.camunda.io/e0d3996c-b748-424b-9283-142ce53df946/new';
const forms = [
  {
    title: 'Submit a connector',
    text: 'Share a connector or an element template with the Camunda community.',
    href: `${TASKLIST}/SubmitConnector-V2`,
  },
  {
    title: 'Submit a blueprint',
    text: 'Share a process blueprint, a pattern, or a solution accelerator.',
    href: `${TASKLIST}/Submit_Blueprint`,
  },
];
---

<Base title="Contribute" description="Submit a connector or blueprint to the Camunda Marketplace.">
  <div class="container">
    <h1>Contribute to the Marketplace</h1>
    <p class="intro">
      By contributing to the Camunda Marketplace, you agree to the
      <a href="https://legal.camunda.com/licensing-and-other-legal-terms#terms-of-use-camunda-marketplace"
        >Terms of use for Camunda Marketplace</a
      >. A Camunda team member reviews each submission before publication.
    </p>
    <div class="cards">
      {
        forms.map((f) => (
          <div class="card">
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <a class="button primary" href={f.href} target="_blank" rel="noopener">
              Start the submission form
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .container { margin-top: 40px; max-width: 900px; }
  .intro { color: var(--muted); max-width: 640px; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: 24px; }
  .card h2 { margin: 0 0 8px; font-size: 18px; }
  .card p { color: var(--muted); margin: 0 0 16px; }
  @media (max-width: 700px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
