---
import Redirect from '../../components/Redirect.astro';
import { getListings } from '../../lib/data';
import { u } from '../../lib/url';

/**
 * Old AppDirect URLs were /apps/<id>/<slug> (locale-prefixed variants live
 * under /en-US/apps/). The <id> segment is the stable identifier (slugs may
 * differ), so this page catches /apps/<id>/ regardless of slug.
 */
export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((l) => ({ params: { id: String(l.id) }, props: { l } }));
}

const { l } = Astro.props;
---

<Redirect target={u(`/listings/${l.slug}/`)} name={l.name} />
