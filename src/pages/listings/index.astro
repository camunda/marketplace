---
import Base from '../../layouts/Base.astro';
import { getListings, facetValues, assetUrl } from '../../lib/data';
import { u } from '../../lib/url';
import ListingBrowser from '../../components/ListingBrowser.jsx';

const listings = await getListings();

// Serialisable props for the island.
const browserListings = listings.map((l) => ({
  slug: l.slug,
  name: l.name,
  description: l.description,
  href: u(`/listings/${l.slug}/`),
  icon: assetUrl(l, l.icon),
  type: l.type,
  creatorType: l.creatorType ?? null,
  creatorName: l.creatorName ?? null,
  compatibleVersions: l.compatibleVersions,
  categories: l.categories,
  industries: l.industries,
  useCases: l.useCases,
  runtimes: l.runtimes,
}));

const facetGroups: [string, keyof (typeof listings)[number]][] = [
  ['Creator', 'creatorType'],
  ['Category', 'categories'],
  ['Industry', 'industries'],
  ['Use case', 'useCases'],
  ['Runtime', 'runtimes'],
  ['Camunda version', 'compatibleVersions'],
];
const facets = facetGroups.map(([label, key]) => ({ label, key, values: facetValues(listings, key) }));
const initialType = Astro.url.searchParams.get('type') ?? undefined;
---

<Base title="Browse listings">
  <div class="container">
    <ListingBrowser
      client:load
      listings={browserListings}
      facets={facets}
      initialType={initialType}
    />
  </div>
</Base>

<style is:global>
  .browser {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    margin-top: 32px;
  }
  .browser aside { align-self: start; position: sticky; top: 16px; }
  .browser .group { margin-bottom: 4px; }
  .browser .group h3,
  .browser .group summary { font-size: 14px; margin: 12px 0 6px; cursor: pointer; font-weight: 600; }
  .browser .options { display: grid; gap: 6px; padding: 4px 0 8px; }
  .browser .option { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--foreground); }
  .browser .groupSeparator { margin-top: 8px; }
  .browser .count { color: var(--muted-foreground); font-size: 14px; }
  .browser .results { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .browser .row {
    display: flex;
    gap: 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    color: inherit;
    text-decoration: none;
  }
  .browser .row:hover { text-decoration: none; box-shadow: var(--shadow-sm); }
  .browser .row h3 { margin: 0 0 4px; font-size: 16px; }
  .browser .row p {
    margin: 0 0 8px;
    color: var(--muted-foreground);
    font-size: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .browser .meta { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  @media (max-width: 720px) {
    .browser { grid-template-columns: 1fr; }
  }
</style>
