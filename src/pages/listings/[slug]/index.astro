---
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { getListings, webModelerImportUrl, videoEmbedUrl, parseVideo, assetUrl } from '../../../lib/data';
import { u } from '../../../lib/url';
import { CreatorBadge, Pill } from '../../../components/Badges.jsx';
import { Cta } from '../../../components/Cta.jsx';
import { u } from '../../../lib/url';

export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const { Content } = await render(l.entry);
const importUrl = webModelerImportUrl(l);
const embedUrl = videoEmbedUrl(l);
const videoLink = !embedUrl && l.video ? parseVideo(l.video)?.url : null;

const sidebar: [string, string[]][] = [
  ['Categories', l.categories],
  ['Industries', l.industries],
  ['Use cases', l.useCases],
  ['Resources included', l.resourceTypes],
  ['BPMN types', l.bpmnTypes],
  ['Runtime', l.runtimes.map((r) => (r === 'bundle' ? 'Camunda connectors' : 'Self-hosted'))],
  ['Connector type', l.connectorTypes],
  ['Compatible versions', l.compatibleVersions],
];

const links: [string, string | undefined][] = [
  ['GitHub repository', l.links.github],
  ['Documentation', l.links.docs],
  ['Process preview', l.links.preview],
  ['Request demo', l.links.demo],
  ['Support', l.links.support],
  ['Website', l.links.website],
];
---

<Base title={l.name} description={l.description}>
  <div class="container layout">
    <article>
      <header class="head">
        {l.icon && <img src={assetUrl(l, l.icon)!} alt="" width="72" height="72" />}
        <div>
          <h1>{l.name}</h1>
          <p class="creator">
            {
              l.creatorUrl ? (
                <a href={l.creatorUrl} rel="noopener">{l.creatorName}</a>
              ) : (
                l.creatorName
              )
            }
            {l.creatorType && <CreatorBadge creatorType={l.creatorType} />}
            {l.availability && <Pill>{l.availability}</Pill>}
          </p>
        </div>
      </header>

      <div class="ctas">
        {importUrl && <Cta href={importUrl} primary external>Use in SaaS</Cta>}
        {l.smTemplate && <Cta href={l.smTemplate} external>Use Self-Managed</Cta>}
        {l.links.github && <Cta href={l.links.github} external>GitHub repository</Cta>}
        {l.links.docs && <Cta href={l.links.docs} external>Documentation</Cta>}
        {l.links.demo && <Cta href={l.links.demo} external>Request demo</Cta>}
        {l.links.website && <Cta href={l.links.website} external>Visit website</Cta>}
        <Cta href={u(`/listings/${l.slug}/contact/`)}>Contact</Cta>
      </div>

      {
        embedUrl && (
          <div class="video">
            <iframe src={embedUrl} title={`${l.name} demo video`} allowfullscreen loading="lazy" />
          </div>
        )
      }
      {videoLink && <p><a href={videoLink} target="_blank" rel="noopener">Watch the demo video</a></p>}

      {
        l.gallery.length > 0 && (
          <div class="gallery" role="region" aria-label="Screenshots">
            {l.gallery.map((g, i) => (
              <img src={assetUrl(l, g)!} alt={`${l.name} image ${i + 1}`} loading="lazy" />
            ))}
          </div>
        )
      }

      <div class="body">
        <Content />
      </div>

      {
        l.resources.length > 0 && (
          <>
            <h2>Resources</h2>
            <ul>
              {l.resources.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener">{r.title ?? r.url}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </article>

    <aside>
      {
        sidebar.map(
          ([label, values]) =>
            values.length > 0 && (
              <div class="facet">
                <h3>{label}</h3>
                <p>{values.join(', ')}</p>
              </div>
            ),
        )
      }
      <div class="facet">
        <h3>Links</h3>
        <p>
          {links.filter(([, href]) => href).map(([label, href]) => (
            <><a href={href} target="_blank" rel="noopener">{label}</a><br /></>
          ))}
        </p>
      </div>
      {l.lastModified && <p class="updated">Last updated {l.lastModified}</p>}
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    margin-top: 40px;
  }
  .head { display: flex; gap: 20px; align-items: flex-start; }
  .head h1 { margin: 0 0 4px; }
  .creator { color: var(--muted); margin: 0; display: flex; gap: 8px; align-items: center; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin: 24px 0; }
  .video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 8px;
  }
  .gallery {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    margin: 8px 0 24px;
  }
  .gallery img {
    height: 260px;
    width: auto;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    scroll-snap-align: start;
  }
  .body { font-size: 16px; line-height: 1.6; }
  .facet { border-top: 1px solid var(--line); padding: 12px 0; }
  .facet h3 { margin: 0 0 6px; font-size: 13px; text-transform: uppercase; color: var(--muted); }
  .facet p { margin: 0; font-size: 14px; }
  .updated { color: var(--muted); font-size: 13px; }
</style>
