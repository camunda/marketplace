---
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { getListings, webModelerImportUrl, videoEmbedUrl, parseVideo, assetUrl, runtimeLabel } from '../../../lib/data';
import { u } from '../../../lib/url';
import { CreatorBadge, Pill } from '../../../components/Badges.jsx';
import { Cta } from '../../../components/Cta.jsx';

export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const { Content } = await render(l.entry);
const importUrl = webModelerImportUrl(l);
const embedUrl = videoEmbedUrl(l);
const videoLink = !embedUrl && l.video ? parseVideo(l.video)?.url : null;

const typeLabel = (t: string) => t[0].toUpperCase() + t.slice(1);

const sidebar: [string, string[]][] = [
  ['Type', l.type.map(typeLabel)],
  ['Categories', l.categories],
  ['Industries', l.industries],
  ['Use cases', l.useCases],
  ['Resources included', l.resourceTypes],
  ['BPMN types', l.bpmnTypes],
  ['Runtime', l.runtimes.map(runtimeLabel)],
  ['Connector type', l.connectorTypes],
  ['Compatible versions', l.compatibleVersions],
];

// Call-to-action buttons. Duplicates (e.g. a "Use Self-Managed" URL that is
// also the documentation URL) are shown only once, and any URL that already
// has a button is not repeated in the sidebar links.
const ctas: [string, string | null | undefined, { primary?: boolean }?][] = [
  ['Use in SaaS', importUrl, { primary: true }],
  ['Use Self-Managed', l.smTemplate],
  ['GitHub repository', l.links.github],
  ['Documentation', l.links.docs],
  ['Request demo', l.links.demo],
  ['Visit website', l.links.website],
];
const seen = new Set<string>();
const ctaButtons = ctas.filter(([, href]) => {
  if (!href || seen.has(href)) return false;
  seen.add(href);
  return true;
}) as [string, string][];

const links: [string, string | undefined][] = [
  ['GitHub repository', l.links.github],
  ['Documentation', l.links.docs],
  ['Process preview', l.links.preview],
  ['Request demo', l.links.demo],
  ['Support', l.links.support],
  ['Website', l.links.website],
];
const sidebarLinks = links.filter(
  ([, href]) => href && !seen.has(href),
) as [string, string][];

// Media carousel: the video is the first slide, screenshots follow.
const mediaSlides = [
  ...(embedUrl ? [{ kind: 'video' as const, src: embedUrl }] : []),
  ...l.gallery.map((g, i) => ({ kind: 'image' as const, src: assetUrl(l, g)!, alt: `${l.name} image ${i + 1}` })),
];

// "Open-source"/"listing-only" are internal terms and stay hidden;
// "coming-soon" is meaningful to visitors.
const showAvailability = l.availability === 'coming-soon';
---

<Base title={l.name} description={l.seoDescription ?? l.description}>
  <div class="container layout">
    <article>
      <header class="head">
        {l.icon && <img src={assetUrl(l, l.icon)!} alt="" class="icon" />}
        <div>
          <h1>{l.name}</h1>
          <p class="creator">
            {
              l.creatorName && (
                <a href={u(`/listings/?creatorName=${encodeURIComponent(l.creatorName)}`)}>{l.creatorName}</a>
              )
            }
            {l.creatorType && <CreatorBadge creatorType={l.creatorType} />}
            {showAvailability && <Pill>{l.availability}</Pill>}
          </p>
        </div>
      </header>

      <div class="ctas">
        {ctaButtons.map(([label, href, opts]) => (
          <Cta href={href} primary={opts?.primary} external>{label}</Cta>
        ))}
        <Cta href={u(`/listings/${l.slug}/contact/`)}>Contact</Cta>
      </div>

      {
        mediaSlides.length > 0 && (
          <div class="media" role="region" aria-label="Screenshots and videos">
            <div class="media-track" id="media-track">
              {mediaSlides.map((s) =>
                s.kind === 'video' ? (
                  <div class="slide slide-video">
                    <iframe src={s.src} title={`${l.name} demo video`} allowfullscreen loading="lazy" />
                  </div>
                ) : (
                  <img class="slide" src={s.src} alt={s.alt} loading="lazy" title="Click to enlarge" />
                ),
              )}
            </div>
            {mediaSlides.length > 1 && (
              <div class="media-nav">
                <button type="button" data-dir="-1" aria-label="Previous media">&#8249;</button>
                <button type="button" data-dir="1" aria-label="Next media">&#8250;</button>
              </div>
            )}
          </div>
        )
      }
      {videoLink && <p><a href={videoLink} target="_blank" rel="noopener">Watch the demo video</a></p>}

      {
        l.gallery.length > 0 && (
          <dialog id="lightbox" aria-label="Enlarged screenshot">
            <button type="button" aria-label="Close">&times;</button>
            <img src="" alt="" />
          </dialog>
        )
      }

      <div class="body">
        <Content />
      </div>

      {
        l.resources.length > 0 && (
          <div class="resources">
            <h2>Resources</h2>
            <ul>
              {l.resources.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener">{r.title ?? r.url}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>

    <aside>
      {
        sidebar.map(
          ([label, values]) =>
            values.length > 0 && (
              <div class="facet">
                <h3>{label}</h3>
                <p>{values.join(', ')}</p>
              </div>
            ),
        )
      }
      {
        sidebarLinks.length > 0 && (
          <div class="facet">
            <h3>Links</h3>
            <p>
              {sidebarLinks.map(([label, href]) => (
                <><a href={href} target="_blank" rel="noopener">{label}</a><br /></>
              ))}
            </p>
          </div>
        )
      }
      {l.lastModified && <p class="updated">Last updated {l.lastModified}</p>}
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 48px;
    margin-top: 40px;
  }
  .head { display: flex; gap: 20px; align-items: flex-start; }
  .head .icon {
    width: 72px;
    height: 72px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .head h1 { margin: 0 0 4px; font-size: 32px; font-weight: 600; letter-spacing: -0.01em; }
  .creator { color: var(--muted); margin: 0; display: flex; gap: 8px; align-items: center; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin: 24px 0; }

  /* Media carousel: video and screenshots side-scroll in one strip. */
  .media { position: relative; margin: 8px 0 32px; }
  .media-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 8px;
  }
  .slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  img.slide {
    height: 260px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    background: var(--bg-soft);
    cursor: zoom-in;
  }
  /* Click-to-enlarge lightbox (native <dialog>: Escape and ::backdrop for free) */
  #lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 95vw;
    max-height: 95vh;
  }
  #lightbox::backdrop {
    background: color-mix(in srgb, #000 75%, transparent);
  }
  #lightbox img {
    display: block;
    max-width: 90vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: var(--bg-soft);
  }
  #lightbox button {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: var(--popover, #fff);
    color: var(--foreground);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px color-mix(in srgb, #000 40%, transparent);
  }
  .slide-video {
    width: min(480px, 100%);
    aspect-ratio: 16 / 9;
    border: 0;
    overflow: hidden;
  }
  .slide-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .media-nav {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 4px;
  }
  .media-nav button {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--popover, #fff);
    color: var(--foreground);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .media-nav button:hover {
    border-color: var(--accent-action-default);
    color: var(--accent-foreground-subtle);
  }
  .body { font-size: 16px; line-height: 1.6; }
  /* Prose styles for rendered markdown. The DS preflight (body.c4-ui) resets
     all element defaults, and <Content /> children need :global() to be
     reachable from Astro's scoped styles. */
  .body :global(h1),
  .body :global(h2),
  .body :global(h3),
  .body :global(h4) {
    font-weight: 600;
    line-height: 1.3;
    margin: 28px 0 12px;
  }
  .body :global(h1) { font-size: 26px; }
  .body :global(h2) { font-size: 22px; }
  .body :global(h3) { font-size: 18px; }
  .body :global(h4) { font-size: 16px; }
  .body :global(p) { margin: 0 0 16px; }
  .body :global(a) { color: var(--blue); }
  .body :global(a:hover) { text-decoration: underline; }
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 16px;
    padding-left: 24px;
  }
  .body :global(ul) { list-style: disc; }
  .body :global(ol) { list-style: decimal; }
  .body :global(li) { margin-bottom: 6px; }
  .body :global(li > ul),
  .body :global(li > ol) { margin: 6px 0 0; }
  .body :global(code) {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 0.9em;
  }
  .body :global(pre) {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
    overflow-x: auto;
    margin: 0 0 16px;
  }
  .body :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: 13px;
  }
  .body :global(blockquote) {
    margin: 0 0 16px;
    padding: 4px 16px;
    border-left: 3px solid var(--line);
    color: var(--muted);
  }
  .body :global(img) { max-width: 100%; height: auto; }
  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 24px 0;
  }
  .resources h2 { margin: 32px 0 8px; font-size: 20px; }
  .resources ul { margin: 0; padding-left: 24px; list-style: disc; }
  .resources li { margin-bottom: 4px; }
  .facet { border-top: 1px solid var(--line); padding: 12px 0; }
  .facet h3 { margin: 0 0 6px; font-size: 13px; text-transform: uppercase; color: var(--muted); }
  .facet p { margin: 0; font-size: 14px; }
  .updated { color: var(--muted); font-size: 13px; }
</style>

<script>
  // Media carousel: prev/next scrolls one slide width at a time.
  const track = document.querySelector('#media-track');
  if (track) {
    for (const btn of document.querySelectorAll('.media-nav button')) {
      btn.addEventListener('click', () => {
        const slide = track.querySelector('.slide');
        const step = slide ? slide.getBoundingClientRect().width + 12 : track.clientWidth;
        track.scrollBy({ left: step * Number(btn.dataset.dir) });
      });
    }
  }

  // Click to enlarge: screenshots open in a lightbox dialog.
  const lightbox = document.querySelector('#lightbox');
  if (lightbox) {
    const full = lightbox.querySelector('img');
    for (const slide of document.querySelectorAll('#media-track img.slide')) {
      slide.addEventListener('click', () => {
        full.src = slide.src;
        full.alt = slide.alt;
        lightbox.showModal();
      });
    }
    lightbox.querySelector('button').addEventListener('click', () => lightbox.close());
    // A click on the dialog element itself (not the image) hit the backdrop.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });
  }
</script>
