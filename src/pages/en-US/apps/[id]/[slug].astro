---
import Redirect from '../../../../components/Redirect.astro';
import { getListings } from '../../../../lib/data';
import { u } from '../../../../lib/url';

/**
 * Old locale-prefixed AppDirect listing URLs: /en-US/apps/<id>/<slug>. The
 * slug came from the AppDirect product name and lives in `legacySlug` when
 * it differs from the new slug.
 */
export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((l) => ({
    params: { id: String(l.id), slug: l.legacySlug ?? l.slug },
    props: { l },
  }));
}

const { l } = Astro.props;
---

<Redirect target={u(`/listings/${l.slug}/`)} name={l.name} />
