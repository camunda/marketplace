---
import Base from '../layouts/Base.astro';
import { getListings, isConnector, assetUrl } from '../lib/data';
import { u } from '../lib/url';
import { ListingCard } from '../components/ListingCard.jsx';
import { Cta } from '../components/Cta.jsx';

const listings = await getListings();
// Only connectors built and officially supported by the Camunda team.
const featured = listings
  .filter((l) => l.creatorType === 'camunda' && l.creatorName === 'Camunda' && isConnector(l))
  .slice(0, 6);

const categories = [
  {
    name: 'Connectors',
    icon: 'connectors',
    href: u('/listings/?type=connector'),
    description:
      'Pre-built integrations that connect your processes to the tools and systems you already use.',
  },
  {
    name: 'Blueprints',
    icon: 'blueprints',
    href: u('/listings/?type=blueprint'),
    description:
      'Ready-to-use process templates and solution accelerators to jump-start your next project.',
  },
  {
    name: 'Solutions',
    icon: 'solutions',
    href: u('/listings/?type=solution'),
    description:
      'Complete, partner-built offerings that extend Camunda for your industry or use case.',
  },
  {
    name: 'AI Agents',
    icon: 'agents',
    href: u('/listings/?type=blueprint&useCases=Agentic%20AI%20orchestration'),
    description:
      'Pre-built agents for agentic AI orchestration that plan, decide, and act in your processes.',
  },
  {
    name: 'Solution Accelerators',
    icon: 'accelerators',
    href: u('/listings/?categories=Solution%20Accelerators&categories=Agentic%20Solutions'),
    description:
      'Blueprints and partner offerings that give your next project a head start.',
  },
  {
    name: 'Recognized Migration Partners',
    icon: 'migration',
    href: u('/listings/?categories=Migration%20Solutions'),
    description:
      'Partner offerings that help you migrate from Camunda 7 or other platforms to Camunda 8.',
  },
];
---

<Base
  title="Home"
  description="Reduce the time it takes to orchestrate business processes. Discover connectors, blueprints, and solutions in the Camunda Marketplace."
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Camunda Marketplace</span>
      <h1>Accelerate your process orchestration</h1>
      <p class="lede">
        Discover connectors, process blueprints, and partner solutions that reduce
        the time it takes to build on Camunda.
      </p>
      <form class="hero-search" action={u('/listings/')} method="get" role="search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" name="q" placeholder="Search the Marketplace…" aria-label="Search the Marketplace" />
        <button type="submit">Search</button>
      </form>
      <div class="hero-actions">
        <Cta href={u('/listings/')} primary size="lg">Browse all listings</Cta>
        <a class="hero-secondary" href={u('/contribute/')}>Become a contributor</a>
      </div>
    </div>
  </section>

  <section class="container categories">
    <div class="section-head">
      <h2>What are you building?</h2>
      <p>Explore Marketplace by category and find the right building block for your project.</p>
    </div>
    <div class="grid">
      {categories.map((c) => (
        <a class="category" href={c.href}>
          <span class="category-icon" aria-hidden="true">
            {c.icon === 'connectors' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M9 16v6M15 16v6M7 8h10v8H7z"/></svg>
            )}
            {c.icon === 'blueprints' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            )}
            {c.icon === 'solutions' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5z"/><path d="M12 22V12M3 7l9 5 9-5"/></svg>
            )}
            {c.icon === 'agents' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="11" rx="2"/><path d="M12 8V4M8 4h8"/><circle cx="9.5" cy="13" r="1"/><circle cx="14.5" cy="13" r="1"/><path d="M9.5 16.5h5"/></svg>
            )}
            {c.icon === 'accelerators' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2M14 4c3-2 7-2 7-2s0 4-2 7l-7 7-5-5 7-7z"/><circle cx="15" cy="9" r="1.5"/></svg>
            )}
            {c.icon === 'migration' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13l-3-3M20 17H7l3 3"/></svg>
            )}
          </span>
          <h3>{c.name}</h3>
          <p>{c.description}</p>
          <span class="category-link">Explore &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container featured">
    <div class="section-head row">
      <div>
        <h2>Made by Camunda</h2>
        <p>Connectors built and officially supported by the Camunda team.</p>
      </div>
      <a class="view-all" href={u('/listings/?type=connector&creatorName=Camunda')}>View all Camunda connectors &rarr;</a>
    </div>
    <div class="grid cards">
      {featured.map((l) => (
        <ListingCard
          href={u(`/listings/${l.slug}/`)}
          icon={assetUrl(l, l.icon)}
          name={l.name}
          description={l.description}
        />
      ))}
    </div>
  </section>

  <section class="container">
    <div class="contribute">
      <div>
        <h2>Become a contributor</h2>
        <p>
          Share your connectors and blueprints with the Camunda community and help
          others solve their complex business challenges.
        </p>
      </div>
      <Cta href={u('/contribute/')} primary size="lg">See contribution guidelines</Cta>
    </div>
  </section>
</Base>

<style>
  /* Hero — dark band with an accent glow, inspired by camunda.com */
  .hero {
    background:
      radial-gradient(60% 90% at 80% 0%, color-mix(in srgb, var(--accent-action-default) 45%, transparent) 0%, transparent 60%),
      radial-gradient(50% 80% at 10% 100%, color-mix(in srgb, var(--accent-action-default) 25%, transparent) 0%, transparent 55%),
      linear-gradient(160deg, #1b1440 0%, #100c26 55%, #0a0819 100%);
    color: #fff;
    padding: 96px 0 112px;
  }
  .hero-inner { max-width: 720px; }
  .eyebrow {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 30%, transparent);
    background: color-mix(in srgb, #fff 8%, transparent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .hero h1 {
    margin: 0 0 16px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0 0 32px;
    font-size: 19px;
    line-height: 1.55;
    color: color-mix(in srgb, #fff 78%, transparent);
    max-width: 560px;
  }
  .hero-search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 560px;
    margin: 0 0 28px;
    background: var(--input-background, #fff);
    border-radius: 10px;
    padding: 0 8px 0 16px;
    color: var(--neutral-foreground-subtle);
    box-shadow: 0 8px 24px color-mix(in srgb, #000 25%, transparent);
  }
  .hero-search svg { width: 18px; height: 18px; flex-shrink: 0; }
  .hero-search input {
    width: 100%;
    padding: 14px 0;
    border: 0;
    background: transparent;
    font-size: 16px;
    color: var(--foreground);
  }
  .hero-search input:focus { outline: none; }
  .hero-search button {
    flex-shrink: 0;
    border: 0;
    border-radius: 8px;
    padding: 10px 20px;
    background: var(--accent-action-default);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .hero-search button:hover { opacity: 0.9; }
  .hero-search:focus-within {
    box-shadow: 0 0 0 3px var(--accent-action-default), 0 8px 24px color-mix(in srgb, #000 25%, transparent);
  }
  .hero-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .hero-secondary {
    color: #fff;
    font-weight: 600;
    border-bottom: 2px solid color-mix(in srgb, #fff 40%, transparent);
    padding-bottom: 2px;
  }
  .hero-secondary:hover { text-decoration: none; border-color: #fff; }

  /* Section headings */
  section.container { margin-top: 72px; }
  .section-head { max-width: 560px; margin-bottom: 28px; }
  .section-head.row {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .section-head h2 { margin: 0 0 8px; font-size: 30px; letter-spacing: -0.01em; }
  .section-head p { margin: 0; color: var(--neutral-foreground-subtle); }
  .view-all { font-weight: 600; white-space: nowrap; }

  /* Category cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .category {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    color: var(--foreground);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .category:hover {
    text-decoration: none;
    border-color: var(--accent-action-default);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent-action-default) 15%, transparent);
    transform: translateY(-2px);
  }
  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-background-subtle);
    color: var(--accent-foreground-subtle);
    margin-bottom: 16px;
  }
  .category-icon svg { width: 24px; height: 24px; }
  .category h3 { margin: 0 0 8px; font-size: 18px; }
  .category p { margin: 0 0 16px; color: var(--neutral-foreground-subtle); font-size: 14px; line-height: 1.55; }
  .category-link { color: var(--accent-foreground-subtle); font-weight: 600; font-size: 14px; }

  /* Featured cards grid */
  .grid.cards { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }

  /* Contribute banner — wording inspired by marketplace.camunda.com */
  .contribute {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    border-radius: 16px;
    padding: 48px;
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--accent-action-default) 35%, transparent) 0%, transparent 60%),
      linear-gradient(140deg, #1b1440 0%, #100c26 100%);
    color: #fff;
  }
  .contribute h2 { margin: 0 0 8px; font-size: 28px; }
  .contribute p {
    margin: 0;
    max-width: 520px;
    color: color-mix(in srgb, #fff 78%, transparent);
  }

  @media (max-width: 640px) {
    .hero { padding: 64px 0 96px; }
    .contribute { padding: 32px; }
  }
</style>
