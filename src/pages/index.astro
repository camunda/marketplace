---
import Base from '../layouts/Base.astro';
import { getListings, isConnector, isBlueprint, isSolution, assetUrl } from '../lib/data';
import { u } from '../lib/url';

const listings = await getListings();
const featured = listings.filter((l) => l.creatorType === 'camunda').slice(0, 6);
---

<Base title="Home" description="Connectors, blueprints and solutions for Camunda.">
  <section class="hero">
    <div class="container">
      <h1>Camunda Marketplace</h1>
      <p>Connectors, process blueprints and partner solutions for your Camunda projects.</p>
      <p>
        <a class="button primary" href={u('/listings/')}>Browse {listings.length} listings</a>
      </p>
    </div>
  </section>

  <section class="container stats">
    <a href={u('/listings/?type=connector')}><strong>{listings.filter(isConnector).length}</strong> Connectors</a>
    <a href={u('/listings/?type=blueprint')}><strong>{listings.filter(isBlueprint).length}</strong> Blueprints</a>
    <a href={u('/listings/?type=solution')}><strong>{listings.filter(isSolution).length}</strong> Solutions</a>
  </section>

  <section class="container">
    <h2>From Camunda</h2>
    <div class="grid">
      {featured.map((l) => (
        <a class="card" href={u(`/listings/${l.slug}/`)}>
          {l.icon && <img src={assetUrl(l, l.icon)!} alt="" width="48" height="48" loading="lazy" />}
          <h3>{l.name}</h3>
          <p>{l.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--bg-soft); padding: 60px 0; }
  .hero h1 { margin: 0 0 8px; }
  .hero p { color: var(--muted); max-width: 560px; }
  .stats { display: flex; gap: 24px; margin: 32px auto; }
  .stats a { color: var(--muted); }
  .stats strong { color: var(--ink); font-size: 20px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px;
    color: var(--ink);
  }
  .card:hover { text-decoration: none; border-color: var(--blue); }
  .card h3 { margin: 12px 0 6px; font-size: 16px; }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
