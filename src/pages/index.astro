---
import Base from '../layouts/Base.astro';
import { getListings, isConnector, isBlueprint, isSolution, assetUrl } from '../lib/data';
import { u } from '../lib/url';
import { ListingCard } from '../components/ListingCard.jsx';
import { Cta } from '../components/Cta.jsx';

const listings = await getListings();
const featured = listings.filter((l) => l.creatorType === 'camunda').slice(0, 6);

const categories = [
  {
    name: 'Connectors',
    count: listings.filter(isConnector).length,
    href: u('/listings/?type=connector'),
    description:
      'Pre-built integrations that connect your processes to the tools and systems you already use.',
  },
  {
    name: 'Blueprints',
    count: listings.filter(isBlueprint).length,
    href: u('/listings/?type=blueprint'),
    description:
      'Ready-to-use process templates and solution accelerators to jump-start your next project.',
  },
  {
    name: 'Solutions',
    count: listings.filter(isSolution).length,
    href: u('/listings/?type=solution'),
    description:
      'Complete, partner-built offerings that extend Camunda for your industry or use case.',
  },
];
---

<Base
  title="Home"
  description="Reduce the time it takes to orchestrate business processes. Discover connectors, blueprints, and solutions in the Camunda Marketplace."
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Camunda Marketplace</span>
      <h1>Accelerate your process orchestration</h1>
      <p class="lede">
        Discover connectors, process blueprints, and partner solutions that reduce
        the time it takes to build on Camunda.
      </p>
      <div class="hero-actions">
        <Cta href={u('/listings/')} primary size="lg">Browse all {listings.length} listings</Cta>
        <a class="hero-secondary" href={u('/contribute/')}>Become a contributor</a>
      </div>
    </div>
  </section>

  <section class="container stats">
    {categories.map((c) => (
      <a class="stat" href={c.href}>
        <strong>{c.count}</strong>
        <span>{c.name}</span>
      </a>
    ))}
  </section>

  <section class="container categories">
    <div class="section-head">
      <h2>What are you building?</h2>
      <p>Explore the marketplace by category and find the right building block for your project.</p>
    </div>
    <div class="grid">
      {categories.map((c) => (
        <a class="category" href={c.href}>
          <span class="category-icon" aria-hidden="true">
            {c.name === 'Connectors' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M9 16v6M15 16v6M7 8h10v8H7z"/></svg>
            )}
            {c.name === 'Blueprints' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            )}
            {c.name === 'Solutions' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5z"/><path d="M12 22V12M3 7l9 5 9-5"/></svg>
            )}
          </span>
          <h3>{c.name}</h3>
          <p>{c.description}</p>
          <span class="category-link">Explore {c.count} {c.name.toLowerCase()} &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container featured">
    <div class="section-head row">
      <div>
        <h2>Made by Camunda</h2>
        <p>Maintained by the Camunda team and ready for production.</p>
      </div>
      <a class="view-all" href={u('/listings/')}>View all listings &rarr;</a>
    </div>
    <div class="grid cards">
      {featured.map((l) => (
        <ListingCard
          href={u(`/listings/${l.slug}/`)}
          icon={assetUrl(l, l.icon)}
          name={l.name}
          description={l.description}
        />
      ))}
    </div>
  </section>

  <section class="container">
    <div class="contribute">
      <div>
        <h2>Become a contributor</h2>
        <p>
          Share your connectors and blueprints with the Camunda community and help
          others solve their complex business challenges.
        </p>
      </div>
      <Cta href={u('/contribute/')} primary size="lg">See contribution guidelines</Cta>
    </div>
  </section>
</Base>

<style>
  /* Hero — dark band with an accent glow, inspired by camunda.com */
  .hero {
    background:
      radial-gradient(60% 90% at 80% 0%, color-mix(in srgb, var(--accent-action-default) 45%, transparent) 0%, transparent 60%),
      radial-gradient(50% 80% at 10% 100%, color-mix(in srgb, var(--accent-action-default) 25%, transparent) 0%, transparent 55%),
      linear-gradient(160deg, #1b1440 0%, #100c26 55%, #0a0819 100%);
    color: #fff;
    padding: 96px 0 112px;
  }
  .hero-inner { max-width: 720px; }
  .eyebrow {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 30%, transparent);
    background: color-mix(in srgb, #fff 8%, transparent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .hero h1 {
    margin: 0 0 16px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0 0 32px;
    font-size: 19px;
    line-height: 1.55;
    color: color-mix(in srgb, #fff 78%, transparent);
    max-width: 560px;
  }
  .hero-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .hero-secondary {
    color: #fff;
    font-weight: 600;
    border-bottom: 2px solid color-mix(in srgb, #fff 40%, transparent);
    padding-bottom: 2px;
  }
  .hero-secondary:hover { text-decoration: none; border-color: #fff; }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: -56px auto 0;
    position: relative;
    z-index: 1;
  }
  .stat {
    background: var(--popover, #fff);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    color: var(--foreground);
    box-shadow: 0 8px 24px color-mix(in srgb, #000 8%, transparent);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .stat:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px color-mix(in srgb, #000 12%, transparent);
  }
  .stat strong {
    display: block;
    font-size: 36px;
    line-height: 1;
    color: var(--accent-foreground-subtle);
    margin-bottom: 6px;
  }
  .stat span { color: var(--neutral-foreground-subtle); font-size: 14px; }

  /* Section headings */
  section.container { margin-top: 72px; }
  .section-head { max-width: 560px; margin-bottom: 28px; }
  .section-head.row {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .section-head h2 { margin: 0 0 8px; font-size: 30px; letter-spacing: -0.01em; }
  .section-head p { margin: 0; color: var(--neutral-foreground-subtle); }
  .view-all { font-weight: 600; white-space: nowrap; }

  /* Category cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .category {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    color: var(--foreground);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .category:hover {
    text-decoration: none;
    border-color: var(--accent-action-default);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent-action-default) 15%, transparent);
    transform: translateY(-2px);
  }
  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-background-subtle);
    color: var(--accent-foreground-subtle);
    margin-bottom: 16px;
  }
  .category-icon svg { width: 24px; height: 24px; }
  .category h3 { margin: 0 0 8px; font-size: 18px; }
  .category p { margin: 0 0 16px; color: var(--neutral-foreground-subtle); font-size: 14px; line-height: 1.55; }
  .category-link { color: var(--accent-foreground-subtle); font-weight: 600; font-size: 14px; }

  /* Featured cards grid */
  .grid.cards { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }

  /* Contribute banner — wording inspired by marketplace.camunda.com */
  .contribute {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    border-radius: 16px;
    padding: 48px;
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--accent-action-default) 35%, transparent) 0%, transparent 60%),
      linear-gradient(140deg, #1b1440 0%, #100c26 100%);
    color: #fff;
  }
  .contribute h2 { margin: 0 0 8px; font-size: 28px; }
  .contribute p {
    margin: 0;
    max-width: 520px;
    color: color-mix(in srgb, #fff 78%, transparent);
  }

  @media (max-width: 640px) {
    .hero { padding: 64px 0 96px; }
    .contribute { padding: 32px; }
  }
</style>
