---
import Base from '../layouts/Base.astro';
import { Heading, Text } from '@camunda/design-system/components/ui/typography.js';
---

<Base title="Idea Portal" description="Suggest ideas for new connectors, blueprints, and other Marketplace resources.">
  <div class="container">
    <Heading as="h1" variant="heading-xl">Suggest ideas</Heading>
    <div class="intro">
      <Text as="p" variant="body-md">
        Tell us which connector, blueprint, or other resource you would like to see in the Camunda Marketplace. Vote
        for ideas from other users in the Idea Portal.
      </Text>
    </div>
  </div>
  <div class="portal">
    <iframe
      src="https://portal.productboard.com/qpeogvvcmmr6jnmtu2ektfxy"
      title="Camunda Marketplace Idea Portal"
      loading="lazy"></iframe>
  </div>
</Base>

<style>
  .container {
    margin-top: 40px;
    max-width: 900px;
  }
  .intro {
    margin-top: 16px;
    max-width: 640px;
  }
  .portal {
    margin: 24px 20px 0;
  }
  .portal iframe {
    width: 100%;
    height: 75vh;
    border: 0;
  }
</style>
