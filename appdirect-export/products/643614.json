  "features": [
    {
      "id": "6516104",
      "refId": "59670f0d-497c-4883-b516-0ce538daa6a1",
      "header": "Multi-format feed support",
      "description": "Automatically detects and parses both RSS 2.0 and Atom feed formats, ensuring compatibility with virtually any feed source without manual configuration.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6516105",
      "refId": "9bfd7109-096b-40b7-9cec-7c730c726a2b",
      "header": "Smart date filtering",
      "description": "Filter feed items by publication date using flexible date range parameters (fromDate/toDate) with support for ISO 8601 format and FEEL expressions such as today() and now().",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6516106",
      "refId": "c9587eff-e1ad-4d70-bba6-82591cc24d64",
      "header": "Rich metadata extraction",
      "description": "Extracts comprehensive information from each feed item including title, link, description, author, categories, publication date, and unique identifiers (GUID) for downstream processing.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6516107",
      "refId": "6b763dec-eec2-4166-82b7-1508af097792",
      "header": "Configurable item limits",
      "description": "Control the number of items returned (1-500) with automatic sorting by publication date (newest first), enabling both quick checks and comprehensive feed processing.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6516108",
      "refId": "f99d7a04-9b26-481b-9681-cbeea75b36fa",
      "header": "Built-in error handling",
      "description": "Robust timeout protection (10s connection, 30s request) and specific error codes (FETCH_ERROR, PARSE_ERROR, INVALID_URL) make troubleshooting straightforward and processes more reliable.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6516109",
      "refId": "a1210b87-8b36-44a2-9224-7041b74b1024",
      "header": "Feed metadata access",
      "description": "Provides access to feed-level information including feed title, description, website link, and last build date, enabling intelligent feed source management and monitoring.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
