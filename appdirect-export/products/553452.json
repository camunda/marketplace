  "features": [
    {
      "id": "6245001",
      "refId": "1450f69a-38e2-464c-8ab2-5a5ced3aefef",
      "header": "Asynchronous messaging",
      "description": "Decouples process execution from message delivery. This design enhances process efficiency by preventing delays while waiting for message handling.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6245002",
      "refId": "6e2bf1e0-3bef-4657-a74d-9716600a1a3e",
      "header": "Seamless NSQ integration",
      "description": "Directly connects Camunda-based processes to NSQ. This establishes a straightforward bridge for Camunda processes to interact with the NSQ messaging system.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6245003",
      "refId": "3a4d4cf1-de4c-490a-9318-522368c6eb1f",
      "header": "Customizable via BPMN",
      "description": "Allows configuration of messages and topics within the process model. Developers can easily define message content and target NSQ topics directly in their business process diagrams.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6245004",
      "refId": "ffa3a95d-b63f-402e-be84-193538b2d348",
      "header": "Leverages NSQ capabilities",
      "description": "Utilizes NSQ's distributed and reliable messaging. This ensures robust and scalable message delivery by capitalizing on NSQ's inherent strengths.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
