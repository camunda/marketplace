  "overview": {
    "splashTitle": "Streamline personalized emails in business processes",
    "splashDescription": "Generate and send personalized emails using predefined templates. This connector leverages FreeMarker and Amazon Simple Email Service (SES) to simplify the process of dynamically substituting variables into templates and delivering emails. Use this connector in Camunda-based business processes to automate communication tasks with features such as sender customization, CC/BCC options, and dynamic template data. This connector is ideal for businesses aiming to optimize email operations with minimal effort and maximum efficiency.",
    "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/469785/overview/img6657453865482321014.png?c6fe4ecad40270608690bc09b7219563",
