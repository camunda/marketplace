  "features": [
    {
      "id": "6044560",
      "refId": "2a572435-84b3-4cff-b65b-9f559da13f4b",
      "header": "Dynamic Template Rendering",
      "description": "Easily render email templates using FreeMarker or Amazon SES by dynamically substituting variables with relevant data. This enables the creation of highly personalized and context-aware emails for transactional, marketing, and notification purposes.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6044561",
      "refId": "e5a5208e-8c55-453d-9542-537eaa812748",
      "header": "Seamless Process Integration",
      "description": "Integrate with Camunda SaaS and Self-Managed environments, enabling automated email sending directly within business processes without additional complexities or third-party dependencies.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6044562",
      "refId": "5804161a-6d62-46d6-a611-3e9f0072a7e8",
      "header": "Customizable Email Options",
      "description": "Define sender name, recipient emails, CC/BCC fields, subject lines, and dynamic content to fully customize emails. This ensures your communications are precise and aligned with the specific requirements of your business process.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6044563",
      "refId": "32f9c075-ef58-4fa0-9c75-fc9d8469cfd4",
      "header": "Secure and Simplified Configuration",
      "description": "Quickly configure SMTP and AWS credentials to enable secure and efficient email delivery. The connector ensures sensitive information is handled safely while making the setup process user-friendly.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
