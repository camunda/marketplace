    "blurb": "Integrate any webhook seamlessly, securely",
    "overview": "Integrate any external webhook into your Camunda processes. Supports all HTTP methods and offers robust security through JWT, Basic, API KEY, and HMAC authentication.",
    "rating": null,
    "reviewCount": 0,
    "mobileBundleId": null,
    "mobileAppStoreId": null
  },
  "overview": {
    "splashTitle": "Unleash the Power of Webhooks in Your Camunda Processes",
    "splashDescription": "The generic inbound webhook Connector is your one-stop solution for integrating any webhook into your Camunda processes. Whether it's an HTTP GET for pulling data or an HTTP POST for pushing an update, this Connector can handle it. With support for JWT, Basic, and API KEY authentication, as well as HMAC authentication, you're in control of the security protocols that best fit your needs.",
    "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418745/overview/img4181252663637919840.png?da88ce544f869839269309dcbdb00d1f",
