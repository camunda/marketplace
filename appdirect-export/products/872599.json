  "features": [
    {
      "id": "6716998",
      "refId": "575ad543-b9b9-4057-953b-50fff77001b3",
      "header": "Active Context for Agentic Processes",
      "description": "Expose live, semantically unified enterprise data products via the Model Context Protocol (MCP) to supply the exact contextual data required for non-deterministic AI agent reasoning and automated decisioning.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6716999",
      "refId": "78abd993-6dcc-4cfa-95cb-28e2132209ba",
      "header": "Runtime Governance & Zero-Trust Security",
      "description": "Centrally enforce access policies, row-level filtering, column masking, and data lineage at query execution, guaranteeing that process steps and AI agents only consume data they are explicitly authorized to view.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6717000",
      "refId": "b3fea6ba-9b50-4032-bc65-656ede01bc48",
      "header": "Universal Connectivity Across 200+ Sources",
      "description": "Connect to cloud warehouses, lakehouses, databases, SaaS applications, and legacy systems through a single logical interface without copying data or managing point-to-point ETL pipelines.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6717001",
      "refId": "d7fdd046-2ea2-4b65-9f13-81e9bbcacd07",
      "header": "Zero-Copy Performance & Pushdown Optimization",
      "description": "Execute high-performance cross-source queries using intelligent query pushdown and acceleration, delivering real-time data access while reducing latency and storage duplication.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6717002",
      "refId": "ad1b788b-e5be-44f1-90ec-c7d60ad5b57d",
      "header": "Shared Business Vocabulary & Reusable Data Products",
      "description": "Deliver curated, business-meaningful data products with built-in trust and semantic consistency across all reporting, application, and automated process steps.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
