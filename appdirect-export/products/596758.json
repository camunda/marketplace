  "features": [
    {
      "id": "6314402",
      "refId": "99a74eda-2c43-4f78-a125-3b3e2c057173",
      "header": "Simplified process orchestration",
      "description": "Facilitates event-driven architectures by enabling Camunda to trigger asynchronous downstream actions via Pulsar messages.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6314403",
      "refId": "df17a04e-f23f-4399-a7eb-e85c44fdce3b",
      "header": "Customizable via BPMN",
      "description": "Allows configuration of message content, topics, and publishing parameters within BPMN process models, giving developers flexible control over messaging.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6314404",
      "refId": "9966a536-4b3d-4b03-ba5e-9573f621aa67",
      "header": "Asynchronous messaging",
      "description": "Decouples Camunda process execution from Pulsar message delivery, enhancing process efficiency by preventing delays while waiting for message handling.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6314405",
      "refId": "a8e6c2e1-89cc-43bd-a503-185d72ac695d",
      "header": "Scalable event streaming",
      "description": "Supports high-throughput message publishing, allowing Camunda-based processes to handle large volumes of real-time events seamlessly.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
