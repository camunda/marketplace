  "features": [
    {
      "id": "6350594",
      "refId": "3b5ecf2a-bd21-479e-8e96-613af39087de",
      "header": "Partnership-based collaboration",
      "description": "Our quality promise: nterra is a true partner to its customers. We provide fair and open advice, are authentic and keep our promises. You can rely on our word just as much as you can rely on our decades of experience.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6350595",
      "refId": "5972efe2-53bb-4cae-97ee-14e07a90d45f",
      "header": "Smooth transition",
      "description": "Changing wheels on a moving car? No problem. We reliably replace legacy systems without disrupting your business operations. Careful requirements engineering, agile project management and reliable consultants and developers make all the difference.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6350596",
      "refId": "b4fbe6a9-ba69-457b-8c12-6eab1a4edd26",
      "header": "Ready to work",
      "description": "Whether it's data connectivity or established processes, with nterra you can be sure there will be no nasty surprises. Thanks to countless projects with a wide variety of integration platforms, our team is prepared for anything.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6350597",
      "refId": "39665c43-21db-4043-a5e6-0b55a6e81311",
      "header": "Beyond the launch",
      "description": "After migration, we are happy to remain available for you: with the nterra SmartCenter, we offer operation, support, maintenance and further development of your technical platform by experienced consultants from Germany. Without offshoring, but with up to 24/7 availability, we are at your side.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
