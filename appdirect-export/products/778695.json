  "features": [
    {
      "id": "6475759",
      "refId": "66b30ac8-2056-44fb-8463-f7ad15d4ceec",
      "header": "Intelligent process orchestration",
      "description": "Six BPMN process variants orchestrate the complete inventory management pipeline through Camunda. The primary process chains AI analysis steps (forecast, validate, compare, detect, act) with exclusive gateways that automatically route to procurement triggers or overstock alerts based on AI findings. Processes start via scheduled cron triggers (weekly analysis), manual API calls, or real-time Kafka events when stock levels change. The solution includes 24+ modular job workers that handle each process step independently, enabling horizontal scaling and easy customization.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6475758",
      "refId": "c4d59517-357e-41e2-8d13-fc6e8ed02784",
      "header": "AI-powered demand forecasting and inventory stock analysis",
      "description": "Leverages AWS Bedrock (Mistral LLM) to analyze inventory data and predict demand for the next 7-30 days. The AI engine detects stockout risks, over stock situations, threshold violations, and pattern anomalies, then generates actionable recommendations with confidence scoring. Dynamic prompt generation adapts AI queries to the current inventory context, product category, and analysis type. Includes built-in verification workers that validate AI accuracy before acting on recommendations. Graceful fallback to rule-based analysis when AI services are unavailable.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6475760",
      "refId": "167ef3df-54b0-43c6-b6c6-c7c19496428c",
      "header": "Real-time, event-driven processing with Kafka",
      "description": "Apache Kafka integration enables instant inventory response. When POS or ERP systems publish stock change events (INVENTORY_LOW, STOCKOUT_RISK, INVENTORY_HIGH, INVENTORY_SOLD), Kafka message events automatically trigger the appropriate Camunda process within seconds. The system publishes outbound events for procurement actions and overstock alerts, enabling downstream integration with supplier systems and warehouse management. Supports event correlation for tracking inventory decisions from end to end.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6475761",
      "refId": "19d076e2-50a1-468d-99ea-a468c73d307d",
      "header": "Perishable goods management with dynamic pricing",
      "description": "Specialized module for perishable inventory with automated expiry monitoring and AI-recommended dynamic pricing. Products are classified into status tiers (fresh, warning, critical, expired) with automatic discount recommendations based on days until expiry (for example, 10% at 7 days, up to 50% on final day). The AI engine analyzes demand elasticity, revenue impact, and waste reduction to optimize pricing decisions. Includes a dedicated dashboard with product cards, discount dialogs, financial impact analysis, and promotional strategy recommendations.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6475762",
      "refId": "ced57583-ddcd-4c41-bbd3-7f7df1720c88",
      "header": "Dashboard with multi-channel notifications",
      "description": "A full-featured dashboard provides interactive pages for KPI metrics and trend charts, inventory management with search/filter/status tracking, AI analysis with multiple analysis types, workflow management with live status monitoring, report generation, notification management, and perishable products with expiry tracking. A multi-channel notification system delivers alerts via Slack webhooks and email SMTP with customizable templates for low stock alerts, critical stockout warnings, weekly summaries, and demand forecasts.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
