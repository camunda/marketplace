  "features": [
    {
      "id": "6584481",
      "refId": "78ad16c8-94a9-4730-bf20-6764dc5fc903",
      "header": "Create and schedule meetings",
      "description": "Create scheduled or instant meetings (and retrieve, update, or delete them) directly from a BPMN service task, enabling meeting provisioning as part of onboarding, incident response, approvals, and customer workflows.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6584482",
      "refId": "9ca5e729-dfea-4b71-931c-93320d940e1a",
      "header": "Manage registrants and invitations",
      "description": "Support key meeting administration flows, including creating and managing registrants and accessing invitation-related details, so processes can automate attendee onboarding and meeting communications.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6584483",
      "refId": "a7b165c1-03f0-400c-8937-764743f1a3b4",
      "header": "Secure authorization and flexible output mapping",
      "description": "Use Camunda secrets for the Zoom API authorization and map API responses to process variables via standard output mapping, keeping sensitive values out of BPMN and making results immediately usable downstream.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
