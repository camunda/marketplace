  "features": [
    {
      "id": "5880480",
      "refId": "461966ae-8d6a-40e7-b594-35291551c60b",
      "header": "Push Messages to ActiveMQ Queues",
      "description": "Push messages to an ActiveMQ queue as part of a Camunda-based process.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5880481",
      "refId": "7ff7a384-3403-45e0-82a1-c182323d999c",
      "header": "Push Messages to ActiveMQ Topics",
      "description": "Push messages to an ActiveMQ topic as part of a Camunda-based process.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5880483",
      "refId": "b06c95be-d3c7-470e-85b3-287e26647800",
      "header": "Verify Messages Pushed to Topics",
      "description": "ActiveMQ messages that are sent to a topic are not visible in the ActiveMQ console. Sample code is provided to verify the message that is pushed to a topic, so you can verify it in the logs.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5880482",
      "refId": "ec2b831f-b199-4521-b97f-2586fa1dd56f",
      "header": "Default Credentials for Testing",
      "description": "Default credentials are configured in the Connector to enable easy testing. To use them, select the \"default\" authorization and start sending messages. Ensure you use this feature for testing purposes only.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5880484",
      "refId": "836d0901-b724-4d66-a7ff-72de05a4eaf5",
      "header": "Custom Credentials",
      "description": "You can optionally configure user-provided credentials for the ActiveMQ broker.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "5880485",
      "refId": "0f9411dd-a32b-4fc3-bd32-57f03c2eb7be",
      "header": "Adjustable Delivery Mode",
      "description": "You can optionally adjust delivery modes if you are using the activemq-connector template JSON.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
