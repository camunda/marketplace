  "features": [
    {
      "id": "6321625",
      "refId": "0d80215e-7132-4961-a116-23074397ce93",
      "header": "Create Spreadsheet",
      "description": "Automatically generate a new Google Sheet from a Camunda process, serving as a dynamic data repository for various process steps, such as reporting or data analysis.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6321626",
      "refId": "d4fa18ac-270c-4b76-bb05-7265f93548ac",
      "header": "Add Value to Spreadsheet",
      "description": "Populate your Google Sheet with data right from within Camunda, be it for tracking, data collection, or dashboard updates.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6321627",
      "refId": "89844c7d-b1db-4856-ab82-de1d47a12782",
      "header": "Get Spreadsheet Details",
      "description": "Retrieve metadata and other relevant details of Google Sheets for validation or to inform subsequent steps in your Camunda process.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6321628",
      "refId": "2ec1fb53-22f2-4719-8dff-0bf0b8277e20",
      "header": "Create Worksheet",
      "description": "Create additional worksheets within an existing Google Sheet to organize data in a more segmented manner, all without leaving your Camunda process.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6321629",
      "refId": "782ed5e4-79c9-48ca-8721-600b01c9e6f0",
      "header": "Get Worksheet Data",
      "description": "Pull data from specific worksheets for processing or analysis within Camunda, automating data-driven decisions and actions.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6321630",
      "refId": "edb5aab3-bce8-4642-a0af-e5182428d965",
      "header": "Delete Worksheet",
      "description": "Remove unnecessary or outdated worksheets from Google Sheets, aiding in data maintenance and organization within Camunda.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "6321631",
      "refId": "0c25932b-5134-4812-9a59-da8ee1ff420f",
      "header": "Create Row",
      "description": "Add new rows to a Google Sheet for data appending needs, be it for log tracking or inventory management.",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    },
    {
      "id": "6321632",
      "refId": "d8b18067-d2f1-4ef0-9206-aa235f432dc7",
      "header": "Create Empty Column and Row",
      "description": "Prepare your Google Sheet for future data by adding empty columns and rows, providing a scalable structure for dynamic data entry.",
      "hideOnOverview": false,
      "position": 8,
      "characteristics": []
    },
    {
      "id": "6321633",
      "refId": "69d019ef-51b1-454d-b5ba-d5a2a4c42f24",
      "header": "Delete Column",
      "description": "Remove irrelevant columns to keep your Google Sheets data clean and focused, facilitating easier data management in Camunda.",
      "hideOnOverview": false,
      "position": 9,
      "characteristics": []
    },
    {
      "id": "6321634",
      "refId": "b4108460-2851-4be2-901e-220516b3567f",
      "header": "Get Row by Index",
      "description": "Retrieve specific rows based on their index for targeted data manipulation or reporting within Camunda workflows.",
      "hideOnOverview": false,
      "position": 10,
      "characteristics": []
    }
  ],
