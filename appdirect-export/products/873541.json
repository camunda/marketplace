  "features": [
    {
      "id": "6722230",
      "refId": "b161e72c-5d7f-4043-886b-aeacd66e4f4f",
      "header": "Typed, audit-ready decisions",
      "description": "Replace an LLM-in-the-loop decision with a fast, typed System-1 engine; choice/score/yes-no answers are written straight to process variables through Result Variable or Result Expression.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6722231",
      "refId": "9ff7c5bb-2574-4c28-8d0b-063d1045be23",
      "header": "DecisionPack safety boundary",
      "description": "Only pre-approved decision packs can be referenced from BPMN; an unregistered pack fails the task with an incident rather than silently guessing.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6722232",
      "refId": "be0e61aa-8524-45a6-97c5-641ac732e552",
      "header": "Runs in Camunda's connector runtime",
      "description": "Works in Camunda SaaS connectors or the Self-Managed runtime; no model key is required, because the connector posts the process state to a self-hosted Laya server that you control, over the Jev-compatible /v1/systemone protocol.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
