  "features": [
    {
      "id": "6507100",
      "refId": "037b2e23-44fc-484b-959d-3401700f5a56",
      "header": "Enable migration at scale with precision",
      "description": "MAC provides a structured approach to migrating business processes whether the objective is to modernize a single application, a specific target platform, or a broader process portfolio. It standardizes legacy process definitions on BPMN 2.0 while providing transparency and control throughout the migration lifecycle.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6507101",
      "refId": "43163750-0dcb-437f-bbaa-0d5c7ffe5aec",
      "header": "Deliver measurable business outcomes",
      "description": "MAC accelerates migration from proprietary BPM technologies by reducing manual remodeling effort, migration risk, and time to value. Organizations gain speed, consistency, and predictability throughout BPM transitions, with BPMN established as an open standard foundation for Camunda adoption.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6507102",
      "refId": "6d303ea5-0c84-4aa7-8f11-0738d0d71166",
      "header": "Build a repeatable migration capability",
      "description": "MAC goes beyond point conversion utilities by enabling a repeatable migration capability that supports governance and visibility where required. It remains lightweight enough for targeted, tool-specific migrations, giving organizations the flexibility to scale Camunda adoption at their own pace.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6507103",
      "refId": "c57b5f5f-1ad0-4594-bc71-b41e61cd9435",
      "header": "Choose the right deployment scenario",
      "description": "MAC is well suited for organizations migrating from legacy or proprietary BPM tools to Camunda, whether the goal is to modernize selected processes first or scale migration efforts over time. It delivers clarity and control without over-engineering, supporting long-term platform optionality and reducing vendor lock-in.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
