  "features": [
    {
      "id": "6318183",
      "refId": "a1dd0707-9e1d-4c1d-9f51-127ff703f4ee",
      "header": "Get Tasks from a Project",
      "description": "Retrieve all tasks within an Asana project, enabling Camunda workflows to adapt or make decisions based on the current project status.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6318184",
      "refId": "5b0a931d-9b1b-42a0-9b13-c65012bfacf6",
      "header": "Get a Task by ID",
      "description": "Fetch specific task details from Asana, allowing Camunda to perform tailored actions like updates, notifications, or subsequent task creation.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6318185",
      "refId": "4e20179b-3b1a-4f9a-97ef-d2c4be8aca36",
      "header": "Create a Task",
      "description": "Directly create new tasks within an Asana project from a Camunda workflow, ideal for automating project milestones or triggering sub-tasks.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6318186",
      "refId": "99a8700b-b964-44d7-95e0-466fb8c85fc0",
      "header": "Delete a Task",
      "description": "Remove specific tasks in Asana through Camunda, aiding in workflow clean-ups, or concluding completed or obsolete tasks.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6318187",
      "refId": "53da0cea-1592-43df-9ddf-e18ab4e22486",
      "header": "Get Projects",
      "description": "Enumerate all available Asana projects, facilitating dynamic routing or decision-making within Camunda workflows.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6318188",
      "refId": "29604aea-539c-45b8-b65a-462200e4c2c8",
      "header": "Get a Project by ID",
      "description": "Retrieve specific project details, enabling Camunda to coordinate tasks or adapt existing workflows based on the project's attributes.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "6318189",
      "refId": "bc252cad-7875-4093-97b0-0f457635f975",
      "header": "Create a Project in a Workspace",
      "description": "Automatically set up new Asana projects within a workspace, perfect for initiating new ventures or phases directly from Camunda.",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    },
    {
      "id": "6318190",
      "refId": "33faab39-a6e1-45fa-957a-e79431b4f9c2",
