  "features": [
    {
      "id": "6728318",
      "refId": "28641aaf-c8d6-4503-88f7-77642032042d",
      "header": "Smart user resolution across every task shape",
      "description": "Automatically resolves the right people for each active user task: the assignee when one is set, or the deduplicated list of candidate users and every member of candidate groups when it isn't. You don't need manual branching logic in your BPMN, because one connector call adapts to whichever assignment pattern the task actually uses.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6728319",
      "refId": "190253de-abfa-48c4-80c8-bf36b16164f7",
      "header": "Fine-grained include/exclude control",
      "description": "Layer includeUsers, excludeUsers, includeGroups, and excludeGroups on top of the task's own assignment data to always pull in specific people or groups, or keep them out, regardless of what the task itself defines. Explicit exclusions always win, so you can safely guarantee certain users are never notified even if they're a candidate.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6728320",
      "refId": "15a0ddc7-a983-4ef8-b788-5a5341d57fd9",
      "header": "Resilient in OIDC-secured and SaaS environments",
      "description": "When a cluster's identity is managed by an external OIDC provider and Camunda's native Users API is disabled, the connector doesn't fail. It falls back to a \"shadow user\" built from the raw user ID (recognizing email-style usernames automatically), so downstream steps like notifications keep working without extra configuration.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
