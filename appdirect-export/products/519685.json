  "features": [
    {
      "id": "6246448",
      "refId": "7ccda263-6cb2-4071-ba09-e27d1548c716",
      "header": "AI-powered email triage",
      "description": "Automatically reads, classifies, and routes incoming help desk emails using a combination of deterministic rules and generative AI. Faster responses, fewer errors, and no more manual sorting. Free up your team for high-value, complex support tasks.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6246449",
      "refId": "df04c27b-b3f9-460c-938d-eb548f466513",
      "header": "Process orchestration with Camunda",
      "description": "Seamlessly orchestrates human and AI agents through BPMN processes, ensuring traceable and auditable decisions. Create reliable, scalable, and compliant support processes. Boosts SLA performance and business continuity.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6246450",
      "refId": "69b2ccd1-3520-41b5-8698-14b30adae83c",
      "header": "Human-in-the-loop decisioning",
      "description": "Escalates edge cases or exceptions to human agents with all relevant context attached, providing the right balance of automation and empathy. Agents stay engaged and empowered to resolve what matters most.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6246451",
      "refId": "0f59e553-3faf-44d4-9081-82d23522459d",
      "header": "Composable, enterprise-ready architecture",
      "description": "Modular solution built on open standards, easily integrates into existing tech stacks. Quick to deploy, easy to extend. Future-proof your support infrastructure without vendor lock-in.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6246452",
      "refId": "9728d5d1-c83d-4885-8b2a-a1e9255002d8",
      "header": "Scale up without increasing headcount",
      "description": "Built specifically to handle growing support demand without increasing operational costs. Handles growing ticket volumes without increasing headcount. Supports revenue growth without proportional cost growth.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6246453",
      "refId": "2031006a-c88b-402c-a4dd-87ad0fc96c1d",
      "header": "Enhanced customer experience",
      "description": "Faster, smarter responses with less friction and fewer hand-offs.Quicker, more relevant responses with fewer \"I'll get back to you\" loops.Supports brand perception as responsive, tech-forward, and customer-centric.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "6246454",
      "refId": "8b821ada-3709-4b65-ba1f-9aaa2108c69b",
      "header": "More engaged support staff",
      "description": "Offload repetitive tasks to automation, empowering humans to focus on meaningful work. Reduces burnout and attrition in support teams. Improves employee satisfaction  correlating with better service quality and retention.",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    }
  ],
