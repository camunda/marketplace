    {
      "id": "6321637",
      "refId": "244a0df6-79d8-4cd2-bc8e-d5bb1543e654",
      "header": "Configurable REST Calls",
      "description": "Configure your REST API calls with standard HTTP methods, headers, and other configurations. This feature is ideal for cases where you need to retrieve status updates from third-party services that do not provide real-time event notifications, such as ticketing systems, order management systems, or any external database.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6321638",
      "refId": "3aec3524-15a6-48fd-8880-5f8dce1f124d",
      "header": "Polling Interval and Conditions",
      "description": "Define the frequency of polling and set conditions that determine when to trigger an intermediate event. Use this feature for continuous monitoring of long-running processes or to check for specific status changes that require immediate action within your workflow.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
