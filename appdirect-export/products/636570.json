  },
  "overview": {
    "splashTitle": "AI-driven supplier onboarding, simplified",
    "splashDescription": "Acheron’s AI-Powered Supplier Onboarding System blueprint transforms traditional, slow, manual vendor onboarding into a fast, intelligent, and compliant workflow. Built with Camunda, AI, and business rules (DMNs), it automates document validation, compliance checks, and risk scoring, all while keeping humans in the loop for critical exceptions. The result is onboarding cycles reduced from 12 days to under 5, unified supplier data across ERP and CRM, and full compliance visibility at enterprise scale.",
    "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/636570/overview/img5193696540788166540.png?e53eb3becec0dab127b40153f29aecb4",
