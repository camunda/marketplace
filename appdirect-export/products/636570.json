    {
      "id": "6350629",
      "refId": "f9a880a0-2aa4-43b3-a905-6576edd91ecc",
      "header": "AI-driven document processing",
      "description": "Extracts and validates supplier documents like tax forms, banking details, and certifications, reducing manual effort and ensuring data accuracy.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6350630",
      "refId": "293d3687-61d2-48df-8a46-44a4f2796ac5",
      "header": "Automated risk and compliance checks",
      "description": "AI and DMN rules classify suppliers by risk level, check sanction lists, and flag license expiries, ensuring faster, compliant onboarding.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6350631",
      "refId": "05a2ba74-bfb3-4210-a877-e0b63e647695",
      "header": "Duplicate supplier detection",
      "description": "Prevents data duplication across ERP and CRM systems, maintaining a single source of truth and cleaner master data.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6350632",
      "refId": "b85c8041-ed1a-4764-93f1-30a106f9b786",
      "header": "Smart exception management",
      "description": "Routes flagged cases to compliance or finance automatically, while AI drafts supplier communication emails, minimizing back-and-forth delays.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6350633",
      "refId": "33eac7b7-41d7-4e06-ad91-67521b9cd6ac",
      "header": "Unified ERP creation and visibility",
      "description": "Seamlessly integrates validated suppliers into ERP, synchronizing data and enabling complete visibility across procurement systems.",
