  "features": [
    {
      "id": "5712577",
      "refId": "2336c5e8-57b4-44bf-aa97-9547555d8c42",
      "header": "Dynamic Content Composition",
      "description": "Easily automate the creation of personalized emails, social media messages, and other forms of written communication. This Connector uses input variables and customizable templates to dynamically generate content that feels personal and engaging.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5712578",
      "refId": "8c77bb24-4bce-4fce-ab7e-55b8a44cce6b",
      "header": "Template-Driven Generation",
      "description": "By defining text templates with variable placeholders and generation instructions, you can ensure a consistent structure of the resulting text and incorporate process variables without exposing them to the LLM.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5712579",
      "refId": "d16e8f37-405b-4156-9616-c2ca1f7d8a61",
      "header": "Tone and Style Settings",
      "description": "Maintain the right tone and style across all your communication with adjustable settings. Whether you need a formal tone for business emails or a friendly approach for social media interactions, this Connector adapts to the desired tone and style to fit the context of your message.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5712580",
      "refId": "c5742486-f599-47ac-bef9-a02368e0cb9a",
      "header": "Multilingual Support",
      "description": "Break language barriers with the ability to compose messages in various languages.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
