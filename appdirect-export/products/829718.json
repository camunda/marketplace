      "id": "6635382",
      "refId": "47457025-f252-4247-af9c-430e243fcc86",
      "header": "Embed an agent in your process",
      "description": "Connect an AI agent to a Camunda process using the included BPMN template. The blueprint demonstrates how to wire agent tool calls into a service task, giving teams a working reference for agent integration patterns.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6635383",
      "refId": "fa7bd255-5237-4970-b739-07e632597636",
      "header": "Retrieve current time and date",
      "description": "Expose time and date as a tool available to the agent during process execution. Use this as a reference for adding context-aware capabilities to your own agent implementations.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6635384",
      "refId": "7af3864a-12c8-4480-9d3c-bc6f251b5c5d",
      "header": "Handle waits and user communication",
      "description": "Pause process execution and resume based on incoming events, with a pre-built example for communicating with end users via Slack message events. Adapt the pattern to other messaging channels as needed.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
