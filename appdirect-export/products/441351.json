  "features": [
    {
      "id": "6246466",
      "refId": "d02973a6-af97-45a9-a8c5-ce97d1d3250a",
      "header": "Queue Item Creation",
      "description": "Camunda initiates tasks that generate queue items in UiPath. Once these items are created, they automatically trigger UiPath bots to begin their respective processes, ensuring a streamlined workflow and timely task execution.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6246467",
      "refId": "e98cb822-4cf5-4367-a815-b6fea2a73cc7",
      "header": "Feedback Integration",
      "description": "While tasks are being executed, UiPath bots provide real-time status updates which Camunda captures and integrates into the process. If any errors occur, the bots report back to Camunda, allowing for immediate awareness and action.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6246468",
      "refId": "eb19cdab-a261-4027-becd-61294c2d698c",
      "header": "Incident Resolution",
      "description": "When incidents arise, Camunda automates the management process by initiating steps such as compensation or escalating the issue to human operators if necessary. ",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
