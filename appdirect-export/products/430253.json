      "id": "5729966",
      "refId": "d1853b77-00aa-44ec-97e5-2673be76b6cb",
      "header": "Start Process Run",
      "description": "Start a process in Robocorp by providing a Robocorp instance URL, the process ID, and your workspace ID (which can be retrieved using the Get Workspace feature or through the control room). Returned data is stored in the \"output\" variable.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5729967",
      "refId": "941254bd-bec2-4f72-9860-937a86861899",
      "header": "Stop Process Run",
      "description": "Stop a process run by providing the process run ID and your workspace ID. This feature also requires the \"set remaining work items as done\" and \"terminate activity runs\" variables to be set to true or false. You can use the Start Process Run feature to get the process run ID.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5729968",
      "refId": "809e9f93-42f7-42b5-a324-9d912220a7cb",
      "header": "Get Workspace",
      "description": "Get the workspace ID from Robocorp to enable other operations. Simply provide the workspace ID found in the control room.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
