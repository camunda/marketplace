    "blurb": "Orchestrate Microsoft Dataverse with Camunda",
    "overview": "Integrate Microsoft Dataverse into Camunda business processes and create, edit, and delete Dataverse entries on the fly.",
    "rating": null,
    "reviewCount": 0,
    "mobileBundleId": null,
