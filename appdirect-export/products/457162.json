  "features": [
    {
      "id": "5946469",
      "refId": "141a0ffc-10fd-4749-94bb-9aa90664024b",
      "header": "Get Entry Information",
      "description": "Fetch all entries or a specific table entry from a Dataverse environment using GET requests.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5946470",
      "refId": "9265e109-f47d-4d22-a898-ca9305785848",
      "header": "Create, Update, and Delete Entries",
      "description": "With the Dataverse Connector, you can create new entries, update existing entries, and delete entries you no longer need. This is done through using POST, PATCH, and DELETE requests, respectively.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5946471",
      "refId": "2f671aea-1b15-4df9-bae3-f68a513d23f4",
      "header": "Customize Outputs",
      "description": "Adjust the amount of data from table entries that you want to see and use in processes. By specifying which attributes should be displayed and what the body of a request should look like, you can freely customize the output.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
