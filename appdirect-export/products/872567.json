  "features": [
    {
      "id": "6710253",
      "refId": "38d04f7c-0b3b-4816-83cf-e8e514d3f27c",
      "header": "Pick the best option",
      "description": "Choose the best match from a list of any size, such as products, documents, or next actions. Get the winning ID with its probability and confidence, plus a ranked top N.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6710254",
      "refId": "1fe23dbd-94b8-4547-9053-75b6814d8f6b",
      "header": "Find every match",
      "description": "Return all options that fit a request using Jev's yes/no (noul) scoring. Set a threshold and an optional maximum, and get every match sorted by score.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6710255",
      "refId": "a0958bf3-b8b0-4056-b855-cf76f3de6fcc",
      "header": "Ask custom questions",
      "description": "Ask your own noul, choice, and score questions about any input in a single call. For example, ask about department, urgency, and customer frustration at once.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6710256",
      "refId": "bc635192-2339-4071-b591-be99a38d191f",
      "header": "Handle lists of any size",
      "description": "Jev accepts up to 255 options per choice question. The connector splits larger lists into groups, runs rounds in parallel, and keeps every request within the token limit automatically.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6710257",
      "refId": "42d78710-6d14-488d-ad5e-12f49920d1b9",
      "header": "Route decisions by confidence",
      "description": "Flag low-confidence decisions with needsReview, so a gateway can send them to a person before the process continues.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6710258",
      "refId": "938b1dab-403a-47e7-ac61-a9c0ef7efc4b",
      "header": "Trace every decision",
      "description": "Get the process instance key, element ID, model version, token usage, duration, and request ID with every result. Keep API keys in Camunda secrets, and let the connector retry rate limits and server errors automatically.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
