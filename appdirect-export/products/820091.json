  "features": [
    {
      "id": "6604991",
      "refId": "265d7ddb-fcc3-45f2-8d88-0244b18fc3f1",
      "header": "Source templates from multiple storage locations",
      "description": "Retrieve Jasper report templates from Camunda document storage, a public or authenticated URL, or a connected drive. No custom integration code is required to locate and load template files at runtime.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6604992",
      "refId": "941b9d43-e7f0-4630-b2ea-9636e286bcd0",
      "header": "Inject process context automatically",
      "description": "Supply reports with live process data including process instance key, process definition name, and the current process diagram. Context is passed directly to the Jasper engine without additional configuration.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6604993",
      "refId": "0a310914-fd3c-46d1-926f-4de05777a7ac",
      "header": "Control variable scope to protect process data",
      "description": "Process designers define which variables are accessible to the report engine. This scoping ensures that only intended data is exposed, keeping sensitive process variables out of generated output.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
