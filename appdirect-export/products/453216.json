  "features": [
    {
      "id": "5912621",
      "refId": "0b901b6f-e526-4bc9-acf9-c1de72930d72",
      "header": "Automated Initial Validation",
      "description": "The system starts with an automated check of the submitted claims to ensure they meet the initial criteria for processing. This step reduces the workload for manual validators and speeds up processing time by filtering out incomplete claims early in the process.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5912622",
      "refId": "ef8baf33-6f07-4907-9648-440735ad96f9",
      "header": "Customer Interaction and Feedback Loop",
      "description": "When additional information is required from the customer, the system triggers an automated notification and waits for the response. This ensures that all necessary data is collected before further processing, minimizing errors and omissions.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5912623",
      "refId": "d0a26a53-1609-498f-9591-45d74b34cbe5",
      "header": "Dynamic Decision-Making with DMN",
      "description": "Acheron's Claims Management System uses DMN tables to make complex decisions based on predefined rules. For example, a DMN table determines the assignment of a surveyor and can be extended to determine the eligibility of a claim, the required documentation, or the risk level. This approach allows for flexible and transparent decision-making that can be easily adjusted to accommodate changing business rules or regulatory requirements.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5912624",
      "refId": "7295e7c8-ab4d-4de8-8d78-947eb78b2a6c",
      "header": "Parallel Processing for Improved Efficiency",
      "description": "The process is designed to perform several checks and assessments in parallel, significantly reducing the overall processing time. This feature is particularly useful when handling high volumes of claims without compromising the quality of the evaluation.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5912625",
      "refId": "0f5c61a1-436c-4b98-a3ed-f19bce9bc79c",
      "header": "Rework and Resubmission Pathways",
      "description": "If the process identifies that a claim needs corrections, it reroutes the claim for rework. The system provides clear instructions on what needs to be amended, supporting a streamlined resubmission process.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
