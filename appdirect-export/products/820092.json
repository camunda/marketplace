  "features": [
    {
      "id": "6619562",
      "refId": "d6428bc1-b17e-4427-bc5a-afc21d4ab366",
      "header": "Process PDFs and images in business processes",
      "description": "Submit PDF documents and image files such as PNG and JPEG to Google Cloud Document AI processors directly from a Camunda service task. Files are passed in Base64 format and results are returned as structured process variables.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6619563",
      "refId": "29a05f6e-801d-4deb-85ef-531f1610ca03",
      "header": "Extract text, entities, and tables automatically",
      "description": "Receive structured extraction results from Document AI including OCR text, named entities, table data, and confidence scores. Use extracted values in downstream process steps without manual parsing.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6619564",
      "refId": "af401f1f-9994-4bc2-a657-063b7b093fa5",
      "header": "Authenticate securely with Google Cloud",
      "description": "Generate access tokens automatically from Google Cloud service account credentials using OAuth 2.0. API requests to Document AI are authenticated at runtime without storing static credentials in the process.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6619565",
      "refId": "a71edebc-69ba-488b-bb53-5b02fcb13cc0",
      "header": "Run asynchronously with Camunda job workers",
      "description": "Designed for non-blocking, scalable execution using the Camunda job worker pattern. Supports configurable retry logic so document processing tasks recover automatically from transient failures.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
