  "features": [
    {
      "id": "6723931",
      "refId": "06764b21-fbf6-4e79-bd74-d9a6d0ce5168",
      "header": "Connect AI agents to MCP tools",
      "description": "Use the AI agent connector with MCP clients to access tools from locally started stdio servers or remote MCP servers over Streamable HTTP or HTTP with SSE.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6723932",
      "refId": "3d1efd71-6be2-4822-ac04-b6cb3326cf2f",
      "header": "Use persistent MCP client connections",
      "description": "Run MCP clients as part of the connector runtime so connections are managed persistently and you reduce overhead in tool discovery and tool calling.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6723933",
      "refId": "9bdc90a9-bbd9-435a-bfb8-a40394020552",
      "header": "Support SaaS with a custom runtime",
      "description": "Connect a custom connector runtime running the MCP Client connector to Camunda SaaS when you need MCP client capabilities in a SaaS cluster.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6723934",
      "refId": "7d2c081a-a449-4760-b890-22d5b9e7eda9",
      "header": "Filter and govern tool access",
      "description": "Allow specific tools or exclude risky tools to control what an AI agent can call; for example, enabling read-only file operations while blocking write actions.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6723935",
      "refId": "80f3f7a4-7189-48c4-9241-403ed6f1cf07",
      "header": "Call MCP operations without an agent",
      "description": "Use standalone mode to list available tools or call a tool directly from a BPMN process without an AI agent.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6723936",
      "refId": "4e9952f3-726f-4af0-967a-14147710e2eb",
      "header": "Add human approval steps",
      "description": "Combine MCP tool flows with other BPMN elements such as user tasks or intermediate events to create a human-in-the-loop interaction for tool calls.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
