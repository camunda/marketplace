  "features": [
    {
      "id": "6663006",
      "refId": "03e506b2-6a7a-47c2-aab0-c67cd885171e",
      "header": "Create work items and route to agents",
      "description": "Push complaints, tasks, cases, and callback requests from your Camunda process directly into NICE CXone agent queues via the Patron API. A pre-built FEEL expression auto-generates the payload using your process instance key, and the smart result mapping extracts the contactId so you can track the work item through the rest of your workflow. Use it with the dedicated Create Work Item template for a streamlined experience, or the main connector for full control.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6663007",
      "refId": "2fabe321-1b63-4257-a077-877073f58f1a",
      "header": "Check agent availability for smart routing",
      "description": "Query real-time agent states, skill queue metrics, and agent activity from within a Camunda process using the Real-Time Data API. The built-in result expression calculates available and busy agent counts and returns a hasAvailableAgents Boolean; drop it into a gateway to route work to live agents when they're free or queue it for later when they're not. Filter by skill ID to check availability for specific teams.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6663008",
      "refId": "c082d87e-5071-45fd-a358-6cad3cc6e1b9",
      "header": "Manage your contact center end-to-end",
      "description": "Go beyond work items and agent status with 22+ operations spanning the full CXone platform. Look up agents, skills, and teams through the Admin API. Pull contact history and performance summaries from Reporting. Send outbound messages and manage conversations via Digital Engagement. Start and end agent sessions, set agent states, and build custom calls to any CXone endpoint, all configured through Camunda Modeler with no code required.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
