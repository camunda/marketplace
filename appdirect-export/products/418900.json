  "overview": {
    "splashTitle": "Manage Data Securely with the SFTP Connector for Camunda",
    "splashDescription": "Secure File Transfer Protocol (SFTP) uses secure shell encryption to provide a high level of security for sending and receiving files. You can use the SFTP Connector to connect to a remote server and perform file and folder operations securely as part of your business processes that are orchestrated by Camunda. Elevate your data management capabilities and streamline remote server interactions for enhanced productivity and control.",
    "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/overview/img155507165352875585.png?1471f258578c44fc8a88ede96ee688e0",
