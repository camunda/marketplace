  "features": [
    {
      "id": "5674323",
      "refId": "deb222e6-82e4-4901-96de-0fc90ae3b3d5",
      "header": "Copy File",
      "description": "Automate the process of copying files from one location to another on an SFTP server. This feature is ideal for backup procedures, data synchronization, and sharing information between different applications.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img5936567973168793527.png",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5674324",
      "refId": "66c65541-d3de-4458-83af-1bb78ce41c14",
      "header": "Copy Folder",
      "description": "Enable automated folder copying within an SFTP server for use cases such as cloning entire directories for backup or migration, or for initializing new environments.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img7226880892849654383.png",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5674325",
      "refId": "8515b61c-6947-4389-9328-1cf28c0b57a0",
      "header": "Create Folder",
      "description": "Automate the creation of new folders on an SFTP server. This feature can be used for processes that set up new project structures, for organizing files, or for preparing storage for incoming data.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img8908493653882151380.png",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5674326",
      "refId": "b932088b-c36c-4be2-9d9f-d869bf7808c4",
      "header": "Delete File",
      "description": "Automate the process of deleting specific files from an SFTP server. This operation is essential for data cleanup, compliance, and archiving tasks where certain files need to be removed.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img1148441817737492128.png",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5674327",
      "refId": "028eacb4-1d21-4636-8747-2abb5cce775d",
      "header": "Delete Folder",
      "description": "Automatically delete entire folders from an SFTP server. This feature is ideal for purging outdated or unnecessary directories as part of automated data management processes.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img3028552713585028874.png",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "5674328",
      "refId": "9ec54ef5-5cd6-4573-86ac-89f7d4ed77e5",
      "header": "List Files",
      "description": "Automatically list all files in a specified folder on an SFTP server for scenarios such as inventorying assets or preparing for batch operations, or for monitoring the state of directories.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img8700355532094789093.png",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "5674329",
      "refId": "5802777b-02c6-47eb-bcf7-3469b255e0da",
      "header": "List Folders",
      "description": "Retrieve a list of all folders within a specified directory on an SFTP server. Use this feature for tasks involving folder navigation, data organization, and workflow logging.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418900/feature/img4700347456708538881.png",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    },
    {
      "id": "5674330",
      "refId": "e09fa415-028c-4663-b292-9746973c67bf",
      "header": "Move File",
      "description": "Move files from one folder to another on an SFTP server to reorganize data, archive folders, and transition files through different stages of a workflow.",
