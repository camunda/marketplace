  "features": [
    {
      "id": "5712585",
      "refId": "0ace90ad-a00a-479e-aa22-179e062108c8",
      "header": "Automated Decisions and Classification",
      "description": "Supercharge your process automation with AI decision-making capabilities. Designed for versatility, the Connector handles general decision tasks, document classification, and more, streamlining your workflow and improving operational efficiency.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5712586",
      "refId": "d2a9ad3d-1bcf-468e-887a-f9f2da2e0ecf",
      "header": "Explainability and Confidence Estimation",
      "description": "Elevate trust in automated decisions with explainability features that provide reasoning descriptions for decisions that are made by AI models. Set a confidence threshold to automatically defer to human judgment when the model is uncertain, ensuring high accuracy and oversight in decision-making.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5712587",
      "refId": "2b249197-5139-432b-88cc-56a6d68f165e",
      "header": "Multimodal Support",
      "description": "Accept input data in various forms and modalities including PDFs, images and audio. You can input documents via file paths or web URLs, making the Connector adaptable to a wide range of sources and ensuring seamless integration into your existing processes.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5712588",
      "refId": "3e8e91a5-4e00-43b3-98d4-61b9c6a1579e",
      "header": "Integrated OCR Capabilities",
      "description": "Extract text from images and scanned documents with embedded or API-based OCR, enabling decisions based on non-text documents, even if the model only supports text.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5712589",
      "refId": "42faca2a-3b09-436d-961b-09d6c91c977d",
      "header": "On-premises Support",
      "description": "Leverage built-in support for local AI models for basic use cases, ensuring data privacy, cost efficiency, and enhanced reliability within your infrastructure.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
