  "features": [
    {
      "id": "6526880",
      "refId": "04fb24cf-05c6-4859-919b-5cc793955a49",
      "header": "Advance or rewind dates by hours within business hours",
      "description": "Given a start date and time, a duration in hours, and a business calendar with open and closed periods, the connector calculates the resulting date and time — skipping hours outside of business hours. For example: starting 2026-01-16 at 15:34, advancing 6 hours on a 09:00–12:00 / 14:00–18:00 calendar yields 2026-01-20 at 12:34.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6526881",
      "refId": "b0c517cc-0a12-4cc0-afdf-e268255dd64b",
      "header": "Advance or rewind dates by business days, skipping holidays",
      "description": "Given a start date, a duration in days, and a business calendar, the connector calculates the resulting date by counting only working days and skipping public holidays. For example: starting 2026-07-15 and moving back 4 business days on a standard calendar yields 2026-07-08.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6526882",
      "refId": "b67a8c74-01a1-49eb-b8c3-1822958eea02",
      "header": "Advance dates by calendar days or months without business-day rules",
      "description": "For simple calendar-based calculations that don't require business-hour rules, the connector can advance or rewind a date by a given number of calendar days or months. For example: moving back 4 months from 2026-07-02 yields 2026-03-02.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6526883",
      "refId": "c0021a27-accb-49d9-9930-75418b3812fd",
      "header": "Handle time zone differences between requesters and handling teams",
      "description": "When the requesting user and the handling office are in different time zones, the connector calculates the correct SLA deadline in both. For example: a back office in Los Angeles operates 09:00–18:00 PT. A request arrives in New York at 09:15 ET. With a 4-hour SLA measured against Los Angeles open hours, the connector returns 14:00 ET as the deadline for the New York requester.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
