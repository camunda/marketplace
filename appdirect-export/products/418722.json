      "id": "6321651",
      "refId": "5139589c-4db3-4e98-9fd3-f66c74304d42",
      "header": "Consume Message",
      "description": "This feature enables Camunda to consume real-time messages from Kafka topics. For example, incoming messages can trigger immediate actions or initiate complex workflows within Camunda, such as order processing or real-time analytics.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6321652",
      "refId": "7008f2a9-b0da-430b-a8c2-4a3366876ed4",
      "header": "Produce Message",
      "description": "Empower Camunda workflows to produce messages to Kafka topics. This feature can be beneficial for initiating downstream activities in other systems (such as inventory updates or sending notifications), all orchestrated seamlessly within Camunda.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
