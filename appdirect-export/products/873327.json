  "features": [
    {
      "id": "6717008",
      "refId": "a3e0b7a6-8764-4cd9-9740-93ef5479f69d",
      "header": "Let the inbox sort itself",
      "description": "Process incoming emails automatically as soon as they arrive in the Microsoft 365 mailbox. Users press no button, maintain no mail rules, and need no training, so they simply keep working while their inbox sorts itself.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6717009",
      "refId": "d85290bc-1248-49b0-9e4b-5cefe6127dd0",
      "header": "Protect privacy by design",
      "description": "Sanitize email content before any AI processing by detecting and masking person names, phone numbers, addresses, email addresses, and links, and by pseudonymizing the sender. The AI model only ever sees placeholders, while the original email in Microsoft Outlook remains completely untouched. The solution uses a single EU-hosted data processor, which keeps GDPR requirements in focus.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6717010",
      "refId": "71ecf749-7885-484a-bb31-f389234711a7",
      "header": "Classify emails by topic with AI",
      "description": "Assign one of seven categories (customer request, invoice, contract, private, marketing/spam, security threat, or other) and rate confidence with an LLM on Amazon Bedrock. The classification works reliably on masked content, so data minimization never comes at the expense of accuracy.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6717011",
      "refId": "c65ef3d6-9f85-4c36-9e84-0bedc11378d0",
      "header": "File emails with human-in-the-loop review",
      "description": "Move each email into the matching Outlook folder via Microsoft Graph, and keep it marked as unread so nothing slips past the user. Unclear emails go to a dedicated review folder for a human decision instead of being guessed, and suspected security threats always go straight to a security folder and are additionally tagged when sent from free-mail addresses.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6717012",
      "refId": "1c1bec34-58dd-4df1-b609-a97817fda2d5",
      "header": "Orchestrate the entire process with Camunda",
      "description": "Orchestrate intake, content extraction, anonymization, AI classification, and filing with Camunda, including automatic error handling if an email cannot be moved, and gain full transparency and traceability for every processed email.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
