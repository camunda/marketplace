  "features": [
    {
      "id": "6320383",
      "refId": "2683b4a0-179d-42a8-b797-ca7d9c0b4541",
      "header": "Create an Address",
      "description": "Allow a Camunda process to create new shipping addresses within EasyPost. This feature is perfect for initiating shipments based on process events to implement use cases such as customer and employee onboarding.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6320384",
      "refId": "7e51ee39-598b-40b5-82bb-614e2dc925b3",
      "header": "Create a Parcel",
      "description": "Use Camunda to define new parcel specifications in EasyPost, enabling automated parcel creation based on inventory, order status, and other business triggers.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6320385",
      "refId": "fa35414f-af54-4256-a1a1-353d14b92dd8",
      "header": "Create a Shipment",
      "description": "Coordinate the shipping process by creating new shipments within EasyPost directly from Camunda-based processes. This feature is ideal for order fulfillment, returns management, and other logistics needs.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6320386",
      "refId": "715ca5ca-20be-4956-aed1-7e0154940989",
      "header": "Buy a Shipment",
      "description": "Automate the purchase of shipping labels via EasyPost, integrating cost calculations and shipping options directly into your Camunda-based processes.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6320387",
      "refId": "267bd3e0-8924-4070-b17a-ae9093e086b5",
      "header": "Verify a Created Address",
      "description": "Validate newly created or existing addresses within EasyPost, ensuring that the shipping process is initiated with accurate information.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6320388",
      "refId": "6d804909-8bbb-4805-8df8-bebdf17b3dc3",
      "header": "Retrieve a Tracker by ID",
      "description": "Get real-time shipping status by retrieving tracking information from EasyPost. Use this data to update workflows, notify customers, or make logistical adjustments.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
