  "features": [
    {
      "id": "6498071",
      "refId": "289b5cab-f86a-44ed-8853-c31e01766072",
      "header": "AI-powered purchase classification",
      "description": "Automatically categorizes purchase requisitions using GPT-4o-mini into type (stock, non-stock, service, capital), category (raw materials, packaging, ingredients, equipment), and urgency level (low, medium, high, critical). Eliminates manual classification effort and ensures consistent, accurate routing from the start.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6498072",
      "refId": "1a272aaf-db0f-4818-aa29-c31741077680",
      "header": "Dynamic approval routing",
      "description": "Decision tables automatically route approvals based on purchase amount, category, and urgency. Low-value, routine purchases auto-approve instantly, while high-value items follow multi-level approval chains with configurable SLA tracking and automatic escalation for overdue tasks.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6498073",
      "refId": "d3190988-c128-43e1-9f7f-653f5ad6b590",
      "header": "Intelligent invoice processing",
      "description": "AI-powered document extraction using AWS Textract and Claude Haiku automatically reads supplier invoices with 90%+ accuracy, extracting invoice numbers, line items, amounts, and PO references. Low-confidence extractions route to AP teams for quick verification, while high-confidence invoices proceed automatically.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6498074",
      "refId": "172407c9-15c9-4798-88b4-b46055facee1",
      "header": "AI-driven three-way match",
      "description": "GPT-4o intelligently compares purchase orders, goods receipts, and invoices, analyzing patterns beyond exact number matching. Provides confidence scores, variance analysis, and actionable recommendations. Perfect matches auto-approve for payment, while exceptions route to AP reviewers with highlighted discrepancies and suggested resolutions.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6498075",
      "refId": "14b93754-b581-4f5b-bd17-4af2ab27f377",
      "header": "Seamless ERP integration and payment automation",
      "description": "Native integration with ERPNext (extensible to SAP, Oracle, Dynamics) automatically creates purchase orders, updates inventory, posts invoices, and executes payments without manual data entry. Smart payment method selection via DMN chooses optimal payment channels (ACH, wire transfer, virtual card) based on amount and supplier location, while automatically capturing early payment discounts to maximize savings.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
