  "features": [
    {
      "id": "6318156",
      "refId": "29b69955-069c-4dd3-8c68-281ce009286e",
      "header": "Receive Events from EventBridge",
      "description": "Leverage Amazon EventBridge as an event source to trigger Camunda processes. This is particularly useful in scenarios where multiple AWS services are involved in your workflow and you want to initiate Camunda tasks based on changes or updates in those services. It also enables centralized event management, making it easier to monitor and troubleshoot your workflows.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6318157",
      "refId": "edb2756d-d137-4956-bf83-22aaa1049916",
      "header": "Send Events to EventBridge",
      "description": "Publish events from Camunda processes to Amazon EventBridge, facilitating interactions with a multitude of AWS services and third-party applications. This allows you to extend your Camunda workflows beyond the BPM engine, integrating them into broader AWS architectures for analytics, monitoring, or further automated actions.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
  ],
