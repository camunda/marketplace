  "features": [
    {
      "id": "6347744",
      "refId": "c6822902-29fb-48c2-a557-89bf4c06582c",
      "header": "Automatic task discovery",
      "description": "Identify active or pending user tasks in a process instance automatically based on state (CREATED, READY, or ASSIGNED). This eliminates manual polling and simplifies orchestration of human workflows.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6347745",
      "refId": "1e048d21-ed6a-4fe7-a04c-d028c582026a",
      "header": "Sub-process navigation",
      "description": "Follow sub-process chains dynamically to locate user tasks even after a parent process has completed. This ensures accurate monitoring and correlation across nested processes.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6347746",
      "refId": "db6eb27e-a897-40f8-a72e-c5c847941682",
      "header": "Real-time process insight",
      "description": "Continuously retrieve up-to-date task metadata (such as task ID, form key, and creation time) to power dashboards, trigger downstream automations, and feed decision logic.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
