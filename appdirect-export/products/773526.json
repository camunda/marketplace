  },
  "overview": {
    "splashTitle": "Connecting OSPlus and Camunda",
    "splashDescription": "The OSPlus connector enables Camunda-based business processes to interact with OSPlus services within the Sparkassen-Finanzgruppe environment. It provides standardized access to selected OSPlus interfaces (e.g. DynS-based services) and allows secure, controlled read and write operations from processes. The connector is designed for use in regulated banking environments and supports the orchestration of end-to-end processes beyond standard OSPlus automation capabilities.",
    "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/773526/overview/img12486109563255305820.png?7758e0cb19ca095e792c260dead1abe9",
