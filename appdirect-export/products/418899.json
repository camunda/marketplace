  "features": [
    {
      "id": "5674294",
      "refId": "1252e31c-86a0-40e4-9ce2-46d7f58861df",
      "header": "Create Epic",
      "description": "Create an epic via camunda.\nExample: Whenever an idea passes the validation phase in your automated ideation process, this feature will automatically create a corresponding Epic in Jira. Capture high-level project objectives without manual intervention, allowing teams to focus on execution.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img8721506831066043218.png",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5674295",
      "refId": "41c57607-0d71-4b89-9b69-81f8d6b806c8",
      "header": "Create Issue",
      "description": "In an automated bug-tracking process, use this feature to directly generate a Jira issue when a new bug is detected. Eliminate manual steps and ensure quicker response times for issue resolution.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img7486107678198577557.png",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5674296",
      "refId": "95609f65-61bf-4328-b449-0cfa591ab385",
      "header": "Get Board Details",
      "description": "If your automated process requires an overview of project statuses, this feature will fetch Jira board details for you. Use the real-time data to make informed decisions within your Camunda workflows.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img5929036745819605051.png",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5674297",
      "refId": "41d9cc6b-65df-4cf9-bd6d-01e6c198b4f7",
      "header": "Get Issue",
      "description": "In processes that require issue tracking and monitoring, this feature fetches the most current information on a Jira issue. Update workflow branches or notifications based on the real-time status of an issue in Jira.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img4610835004950421405.png",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5674298",
      "refId": "b2e6900a-1aef-4aaa-a7a4-fbc9a88ba397",
      "header": "Get Sprint Details",
      "description": "For agile processes that sync with development cycles, use this feature to pull the latest sprint details from Jira. Incorporate this data into your automated workflows to align sprints with business objectives.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img4689164180130587010.png",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "5674299",
      "refId": "96eac2b1-1a44-454b-9a36-fc8db21cf618",
      "header": "Update Epic",
      "description": "When a milestone is reached or modified in your automated process, this feature allows you to update the corresponding Epic in Jira. Keep your high-level objectives in sync without manual updates.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img4597447992790127781.png",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "5674300",
      "refId": "4eeeef52-54d4-42b0-b48d-6c5325d540e8",
      "header": "Update Issue",
      "description": "In an automated customer support workflow, use this feature to update Jira issues based on customer feedback or resolution status. Keep all stakeholders in the loop without requiring manual intervention.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418899/feature/img1363128697417061752.png",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    }
  ],
