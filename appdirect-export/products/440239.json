  "features": [
    {
      "id": "5811041",
      "refId": "4060d18d-b14a-47d3-bb2d-81ac7773f49f",
      "header": "Select Service Type",
      "description": "On the first landing page, customers choose their desired service type: prepaid, postpaid, or fiber. Then they fill in personal details such as name, address, and delivery instructions.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5811042",
      "refId": "4beb4041-53b7-4206-aad7-e141fd065bb5",
      "header": "Approve or Reject Requests",
      "description": "The order approver evaluates service requests from customers and either approves or rejects them. Rejected requests prompt an email notification to the customer with the reason for rejection. Approved requests are forwarded to the resource manager for further processing.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5811043",
      "refId": "4a918e5b-ab13-4cb2-9e60-539a0d404cbe",
      "header": "Assess Resource Requirements",
      "description": "Upon receiving approved requests from the order approver, the resource manager assesses resource requirements. If resources are required, the request is forwarded to the service manager and service engineer. If additional resources are not needed, the customer is notified that the request is complete.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5811044",
      "refId": "382400d4-16a4-4069-a9c3-d0c09e428ee5",
      "header": "Schedule Resource Installation",
      "description": "The service manager reviews requests that the resource manager marked for required services. Based on allocated resources, the service manager schedules a date for resources to be installed at the customer's location.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5811045",
      "refId": "9dbdb6b5-7a77-4f4b-a79b-90a5fefd6617",
      "header": "Customer Notification",
      "description": "After resources are installed on the customer's premises, a notification is dispatched, indicating the initiation of the billing cycle.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
