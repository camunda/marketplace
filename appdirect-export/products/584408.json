  "features": [
    {
      "id": "6297959",
      "refId": "a9edc27d-e48a-454b-9f66-f2d4b788a8f1",
      "header": "AI-driven enterprise search from business processes",
      "description": "Send questions directly from a Camunda-based process to Glean’s AI-powered enterprise search API. Instantly retrieve the most relevant documents, snippets, and links from across your organization's indexed knowledge base.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6297960",
      "refId": "8509a73e-3310-42c4-9b63-b2090d4521c6",
      "header": "Flexible query customization",
      "description": "Easily configure the search query from within a BPMN-based, whether it’s a fixed keyword search or a dynamic question assembled from process variables. Fine-tune parameters such as snippet size, page size, and whether to return LLM-generated content.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6297961",
      "refId": "4601ac24-3089-4dc9-a62e-2d88ab9fa310",
      "header": "Direct result mapping to process variables",
      "description": "Map search results, complete with text snippets and URLs, into structured process variables for downstream tasks. Use this data immediately for approvals, decision gateways, document generation, or chatbot responses.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
