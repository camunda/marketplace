  "features": [
    {
      "id": "6497987",
      "refId": "c4c403ed-120c-4096-a906-098daa0d82ba",
      "header": "Phase 1: Objectives and readiness",
      "description": "The goal of Phase 1 is to establish a shared understanding of the objectives and requirements for migrating to Camunda 8. The general requirements for migration are clarified and the readiness of your processes is determined. The required adjustments and estimates for each step are calculated using carefully created checklists. Our process experts would be glad to discuss the differences compared to Camunda 7 to facilitate the transition for employees with Camunda experience.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6497988",
      "refId": "f95c6478-56f9-46a6-bc77-7dfb91d81310",
      "header": "Phase 2: Migration strategy and pilot project",
      "description": "The goal of Phase 2 is to develop a migration strategy and set up a pilot project. Your team and cimt work together to develop use cases, define interfaces, and plan the initial migration project. Optionally, a code review can be conducted to assess the reusability of external task handling implemented in your Camunda 8 processes.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6497989",
      "refId": "7fadf86a-3916-48ed-b442-44524d67beb2",
      "header": "Phase 3: Implementation and scaling",
      "description": "In Phase 3, the pilot project is implemented. We support your developers in installing Camunda and creating job workers and connectors. We also support your non-coding staff in creating low-code functionalities and establishing best practices. Whether you choose self-hosting in your own data center, self-hosting in the cloud, or Camunda's SaaS solution, we provide you with optimal advice and support in selecting the right operating strategy. cimt also offers managed services for monitoring and incident handling after go-live.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
