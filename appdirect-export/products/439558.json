  "features": [
    {
      "id": "6320362",
      "refId": "2f752d0f-9a11-4052-af79-e675c05f188a",
      "header": "Flexible Model Integration",
      "description": "Utilize any Azure OpenAI model, such as GPT-3.5, Codex, or DALL-E, within Camunda processes to drive innovation and efficiency. This Connector allows you to select the model that best suits their specific needs, whether for text generation, code completion, or image creation, directly enhancing the capability of your business processes.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6320363",
      "refId": "bbfb3d0f-c82f-4aad-aec8-67dc3357cff7",
      "header": "Template Management and Reusability",
      "description": "Design, save, and manage Azure OpenAI Connector templates that capture all technical configurations and settings. Get quick deployment and consistency across different processes and significantly reduce the time and effort required to set up new processes or replicate successful ones across the organization.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6320364",
      "refId": "a874a4a5-f075-49b4-a28f-cfd3bfa21695",
      "header": "Simplified User Experience",
      "description": "Create intuitive templates that streamline the user interface, focusing only on essential inputs and hiding the underlying complexity of AI configurations. This design enhances user adoption by making powerful AI tools accessible to non-technical users, enabling them to leverage AI innovations without needing in-depth knowledge of the technology.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
