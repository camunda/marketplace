      "id": "6677390",
      "refId": "86de2f5f-db6b-42e4-ba17-cb7a55e7c0f4",
      "header": "Cover the full Orchestration Cluster API v2",
      "description": "Query process instances, definitions, element instances, incidents, variables, user tasks, jobs, decisions, batch operations, audit logs, authorizations, groups, roles, tenants and mapping rules, all through one connector.",
