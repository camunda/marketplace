      "characteristics": []
    },
    {
      "id": "6677391",
      "refId": "cd1e1aa5-06e2-4413-baa0-634bf153961a",
      "header": "Stay read-only by design",
      "description": "Exposes no create, update, delete, cancel, migrate or modify operations, keeping the connector safe to use anywhere you need visibility without risk of altering running processes.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6677392",
      "refId": "154955e0-a19e-42be-b55f-e86a4d8a8017",
      "header": "Replace the Operate connector directly",
      "description": "Replaces the deprecated Operate API with the newer Orchestration Cluster API v2, giving you a clear upgrade path with the same familiar querying model.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6677393",
      "refId": "517bfaca-fc92-43a0-ab63-63cd044b2b5e",
      "header": "Works across SaaS and Self-Managed",
      "description": "Connects to Camunda clusters in both SaaS and Self-Managed deployments (8.9 and later), so the same element template works regardless of where your cluster runs.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6677394",
      "refId": "3b5272b2-bfc0-4cbc-98c2-b6f58fbff419",
      "header": "Secure access with OAuth 2.0",
      "description": "Authenticates using OAuth 2.0 client credentials for secure, credential-based access to cluster data.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
