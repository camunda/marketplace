  "features": [
    {
      "id": "6399276",
      "refId": "e2db3ceb-edf0-4805-8639-14a182bf7a40",
      "header": "Archive documents directly from processes",
      "description": "Automatically and directly transfer documents from Camunda BPMN processes into the yuuvis® Momentum archive. Archiving is fully integrated into the process flow – without manual steps or external tools. yuuvis® Momentum is ideally suited as an archive back end for existing DMS solutions, custom applications, or automated archiving processes. No proprietary client – full control over your application logic. Compliant storage according to GoBD, GDPR, and ISO standards.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6399277",
      "refId": "8142e3c6-55e7-4b01-8e9a-c6b5fa9dbde0",
      "header": "Support for structured metadata",
      "description": "In addition to the document itself, relevant process data such as IDs, timestamps, or classifications can be automatically passed along. These metadata enhance later searchability, categorization, and analysis of archived content.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6399278",
      "refId": "8ee0af64-e7ec-4989-bab5-cad56d4d6baf",
      "header": "Work with flexible formats",
      "description": "The connector supports a wide range of document formats, including PDF, XML, and JSON. This makes it suitable for a variety of document-centric use cases, from forms to structured system outputs.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6399279",
      "refId": "3a3e162a-9dbf-4525-b7d5-19fb88f87266",
      "header": "Integrate without middleware",
      "description": "Connection to yuuvis® Momentum is direct via a REST-based API. No middleware or integration platform is required, significantly simplifying both implementation and maintenance.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6399280",
      "refId": "3d13ad35-3414-4f32-b4e5-eedb2d84c169",
      "header": "Ensure compliance",
      "description": "Archiving is audit-proof and meets the requirements of GDPR, GoBD, and internal audit standards. Sensitive or legally required documents are stored securely and traceably.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
