  "features": [
    {
      "id": "6322717",
      "refId": "2beb3436-a431-45af-b1f5-d5b7752cf7ff",
      "header": "Create Queue Item",
      "description": "When a workflow in Camunda requires an RPA bot to perform a task — say, data scraping or customer onboarding — you can use this feature to add this task to the UiPath orchestrator's queue. This feature ensures seamless bot allocation and task execution, contributing to efficient bot orchestration.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6322718",
      "refId": "106264bd-19e8-4b94-9dff-399f59530767",
      "header": "Get Queue Item Result",
      "description": "After an RPA bot has completed its task, you may need to retrieve the result to decide the next steps in your Camunda process. This feature allows Camunda to fetch the outcome, facilitating real-time decision-making and bot orchestration.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
