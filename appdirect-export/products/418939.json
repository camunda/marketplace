  "features": [
    {
      "id": "5597500",
      "refId": "81b89888-0153-4f36-a281-9bf403bea48d",
      "header": "Producer (Upload a File)",
      "description": "This feature is invaluable when your process involves regularly transferring sensitive or bulky files from a local system to a remote SFTP server. Whether it's customer data, software updates, or backup files, securely upload them directly through your Camunda process without manual intervention.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5597501",
      "refId": "92b79907-4076-4718-ab6e-9f09b7f523bd",
      "header": "Consumer (Download a File)",
      "description": "Easily download files from an SFTP server to a local system using this feature. Ideal for workflows that need to acquire remote data for local processing, analytics, or archival. For example, you can automate the download of daily sales reports or configuration files for further analysis or use within other processes.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
  ],
