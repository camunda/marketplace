  "features": [
    {
      "id": "5695088",
      "refId": "6f78b82a-3896-4556-97f7-f005c143ad60",
      "header": "List Blob Containers",
      "description": "Organizing your data starts with understanding the storage containers you have. Use this feature to quickly fetch a list of all blob containers, making it easier to plan your data architecture, carry out migrations, or perform backups.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5695089",
      "refId": "3359c210-0f44-4f9b-ab2f-af0cd83e96f8",
      "header": "List Blobs",
      "description": "Knowing what's in each container is as crucial. This feature allows you to list all blobs in a specific container, making it simpler to manage data, check versions, and ensure that no redundant or unnecessary data is occupying valuable storage space.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5695090",
      "refId": "81fcb528-243d-4122-b0b7-2baf2b7a9efa",
      "header": "Get Blob",
      "description": "This feature allows you to retrieve individual blobs for data analytics, machine learning models, backup purposes and more. This feature ensures that you can pull the data you need when you need it.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5695091",
      "refId": "bc248f62-86c7-4d0c-be59-a9d3a019ea19",
      "header": "Update Block Blob",
      "description": "Keeping your data up-to-date is essential. This feature allows you to overwrite or update chunks of a blob without affecting the rest of the blob. This is highly useful in scenarios such as real-time data streaming, updating log files, and patching content in your cloud storage.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
