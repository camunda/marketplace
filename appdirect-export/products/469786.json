  "features": [
    {
      "id": "6023819",
      "refId": "2de32fb0-c569-44a8-9743-bb2570a16839",
      "header": "Automatically Create Inspection Cases",
      "description": "Trigger the creation of inspection cases in OutSystems directly from Camunda-based processes. Automate and streamline the case initiation process, reducing manual intervention and ensuring timely execution",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6023820",
      "refId": "7a39bd88-3d37-4d80-9437-52ab070cd190",
      "header": "Seamless Data Exchange",
      "description": "Enable real-time data synchronization between Camunda and OutSystems. Ensure accurate and consistent information flow, minimizing errors and improving process transparency.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6023821",
      "refId": "831e559f-81bc-4ed5-b772-fc0e7eb5f249",
      "header": "Orchestrate Processes with BPMN",
      "description": "Leverage Camunda’s BPMN capabilities to design and orchestrate complex processes while delegating inspection case management to OutSystems, ensuring robust process execution.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6023822",
      "refId": "fde9e392-9976-4108-98f5-d8be3e3a09dc",
      "header": "Enhanced Case Management in OutSystems",
      "description": "Use OutSystems to manage the entire lifecycle of inspection cases. Access detailed case updates, handle custom logic, and monitor progress seamlessly.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6023823",
      "refId": "265bbd72-a20e-43ea-89ff-40e48b84f0c8",
      "header": "Scalable and Extensible Solution",
      "description": "Built to handle high volumes of inspection cases, the integration is scalable and can be extended to accommodate additional processes and business domains.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
