  "features": [
    {
      "id": "6508209",
      "refId": "f0e76611-a586-4263-8e73-e5173303ed9f",
      "header": "React to incoming email",
      "description": "The inbound connector turns messages arriving in an Outlook inbox into Camunda events, which you can catch in intermediary events or use to start processes.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6508210",
      "refId": "09042c03-196a-4999-bef2-2964a7b01d60",
      "header": "Post-process emails",
      "description": "Handle incoming emails by marking them as read, moving them, or deleting them.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6508211",
      "refId": "30a34b0f-dae6-4664-b4d8-067ee48e67e9",
      "header": "Filter at your convinience",
      "description": "With support for advanced OData filter queries in addition to a simple setup for common use cases, you can filter emails intelligently and efficiently.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6508212",
      "refId": "8cbce6e5-92c7-4a00-9e9d-761893075bfc",
      "header": "Enterprise-grade authentification",
      "description": "With delegated permissions, users can self-service register and get a refresh token scoped to them and valid for 90 days at a time. Through enterprise applications and client credentials, you can have functional inboxes polled indefinitely by the connector.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
