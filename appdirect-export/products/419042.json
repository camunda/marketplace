  "features": [
    {
      "id": "6320365",
      "refId": "466a33cd-bec1-4f3a-bd76-513ab99ae7d2",
      "header": "Add Work Item to the Queue",
      "description": "Automate the queuing of tasks in Blue Prism by triggering this action from within a Camunda process. This feature enables you to offload repetitive, rule-based tasks to Blue Prism bots, allowing for a more scalable and efficient workflow. The queuing can be conditional based on data points or events captured in Camunda.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6320366",
      "refId": "d4f13246-c4e4-4f4f-875c-a53cccafa7d5",
      "header": "Get Work Item Status",
      "description": "Keep track of the automated tasks you've queued in Blue Prism directly within your Camunda processes. This feature provides real-time visibility into the status of each work item, helping you make informed decisions and maintain smooth operations. You can use this data for logging, error handling, or triggering subsequent steps in a business process.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
  ],
