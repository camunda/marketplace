  "features": [
    {
      "id": "6508336",
      "refId": "56310530-65c0-4d36-ae11-7bb99a9f4fa4",
      "header": "Composable Integration",
      "description": "This is a custom integration that gives you complete flexibility and orchestrates the whole release process, not just deployment. However, with the Web Modeler's native Git Sync feature, you can connect your process applications to a remote repository and synchronize your files with a button click. This feature creates a new commit, which can subsequently initiate your CI/CD pipeline. Learn more at https://docs.camunda.io/docs/next/components/modeler/web-modeler/git-sync/)",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6508333",
      "refId": "bfdebf0f-07ab-4ed2-8150-735160b78794",
      "header": "Version Control Synchronization",
      "description": "Allows you to synchronize contents of a Web Modeler folder to a target GitLab repository by opening a merge request which, when merged, triggers a deployment pipeline.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6508335",
      "refId": "9b78b6d4-aa22-4471-96bf-aa2af7c8b206",
      "header": "Fully Customizable",
      "description": "The blueprint is designed to be used with GitLab but can be adapted to work with other CI/CD tools.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6508334",
      "refId": "7a8be0f7-1575-4538-91be-3e3f2ffbc038",
      "header": "Multi-stage Deployments",
      "description": "Simulates a deployment pipeline across three stages, including a manual review and additional testing. After each successful deployment, a milestone is created to track deployment status.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
