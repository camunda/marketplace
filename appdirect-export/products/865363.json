  "features": [
    {
      "id": "6695991",
      "refId": "7f53e651-c40c-4a3e-9c7a-11ae9b015e9b",
      "header": "Run SQL on a warehouse",
      "description": "Execute a SQL statement, fetch its status and results, page through large result sets by chunk, and cancel a statement in flight. Values are supplied as bound named parameters, so process variables are never concatenated into the statement text.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6695992",
      "refId": "ba7dd6f7-b8ba-44af-baab-86f9377c3217",
      "header": "Control SQL warehouse compute",
      "description": "Start, stop, and inspect a SQL warehouse from the process, so compute is running when a task needs it and shut down when the work is finished.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6695993",
      "refId": "5b3d00f3-38be-4cd8-bae5-f686395d48a3",
      "header": "Trigger and track Databricks jobs",
      "description": "Run a job on demand, poll its run for a terminal lifecycle state, read task output, and cancel a run from a boundary event. An idempotency token is available to make a triggered run safe to retry.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6695994",
      "refId": "33a3f83a-3b00-4d8f-84d1-a5d5c60e087a",
      "header": "Invoke served models",
      "description": "Call a Model Serving endpoint with a chat-style request or a raw payload for a custom model, and read endpoint metadata. Streaming is disabled so responses stay consumable by a synchronous connector, and the job timeout can be raised for slow inference.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6695995",
      "refId": "944745ed-459c-45c0-982e-9d55fbf0a8fe",
      "header": "Query a Vector Search index",
      "description": "Query a Databricks Vector Search index by text or by vector, with result count, filters, query type, and score threshold, to bring retrieval into a process without a separate service.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6695996",
      "refId": "36dc9165-7b94-4735-946a-9f0be1d78223",
      "header": "Skip the custom runtime",
      "description": "Distributed as an element template on Camunda's REST protocol Connector. There is no Java code, custom JAR, or additional worker to operate, and OAuth machine-to-machine authentication with a service principal keeps credentials in Camunda secrets.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
