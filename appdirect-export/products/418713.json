      "refId": "8103fd7b-b221-4bcb-a548-b94cf1327ba1",
      "header": "Send Messages",
      "description": "Facilitate smoother batch processing by queuing messages from Camunda to Amazon SQS. Asynchronous communication allows complex tasks like data analytics or calculations to be handled separately, improving overall operational efficiency",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6319558",
      "refId": "0a81f602-9159-4a22-abe2-8c0f29e2fa18",
      "header": "Receive Messages",
      "description": "Receive messages directly from Amazon SQS within Camunda to act as triggers for specific workflows or tasks. For example, a message in SQS can initiate a customer onboarding process or trigger an inventory restocking event in Camunda",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
