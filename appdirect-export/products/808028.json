  "features": [
    {
      "id": "6526705",
      "refId": "2e0944ad-29c0-4f5e-a3e0-3adef99eb622",
      "header": "Classify threats before they reach AI tasks",
      "description": "The agent classifies injection, jailbreak, harmful intent, policy evasion, sensitive data, privacy, obfuscation, and tool manipulation threats, so nothing unsafe ever reaches your operations.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6526706",
      "refId": "b005bb32-d28d-402c-998e-752440a96bef",
      "header": "Retry automatically on low-confidence decisions",
      "description": "Confidence-based retry for more reliable decisions. When the model's confidence falls below your threshold, the agent refines its prompt and automatically retries. You control how many attempts are made and what confidence level is acceptable.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6526707",
      "refId": "e983b009-76ba-430d-a7af-c2699d75e1b2",
      "header": "Sanitize unsafe prompts and enforce size limits",
      "description": "When a prompt is flagged as warn or block, the agent returns a cleaned version with unsafe directives removed. Legitimate intent is preserved so the process can continue without having to start over.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6526708",
      "refId": "6fea9759-2d84-42b3-8a01-1e80e2c7c5cd",
      "header": "Connect to any supported AI provider",
      "description": "Works with any LLM supported by Camunda: OpenAI, Azure OpenAI, Ollama, and beyond.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6526709",
      "refId": "22792a3b-9f88-4a0b-975d-2a110b6253ad",
      "header": "Validate against real-world threat scenarios",
      "description": "Includes an automated test suite that validates prompt classification against a real LLM, covering block, warn, and allow scenarios out of the box.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
