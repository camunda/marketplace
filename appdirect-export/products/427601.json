  "features": [
    {
      "id": "5699545",
      "refId": "53aa3157-ba6f-4c8d-aa46-cd9f1d4f66f2",
      "header": "Get Token",
      "description": "Retrieve authentication tokens from Azure App Registration, facilitating secure access to various Azure services. This function operates by utilizing specific parameters to request access tokens, which are essential for authorizing and authenticating API calls within Azure's ecosystem.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5699546",
      "refId": "185bb488-5f21-4b9a-849d-6eaede12f6e4",
      "header": "Run Desktop Flow",
      "description": "This function provides seamless integration between Camunda and the Power Platform, enabling the execution of specific desktop flows within Power Automate directly from Camunda-based processes. This capability allows for the automation of desktop and web applications through the orchestration of Power Automate Desktop flows based on business logic defined in Camunda.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5699547",
      "refId": "e9a05c5e-5796-4366-8956-4ac3e6917482",
      "header": "Add Item to Work Queue",
      "description": "This function is an integral part of orchestrating complex automation workflows between Camunda and the Power Platform. It facilitates the addition of tasks or items to a designated work queue in Power Automate, enabling subsequent processing by specific desktop flows. By utilizing this function, one can ensure that tasks are queued for execution in an organized manner, based on the automation logic defined within Camunda-based processes.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
