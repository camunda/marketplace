  "features": [
    {
      "id": "6627444",
      "refId": "d9f2b72a-8318-48b8-9f5b-126fa52a6b1c",
      "header": "Choose from five read operations",
      "description": "Extract a named range as a list of objects, pull an entire sheet, look up a single cell by address or coordinates, or retrieve the full file contents.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6627445",
      "refId": "a869fd2e-fdb4-4bb5-8648-43f13881d1d4",
      "header": "Target any worksheet by name",
      "description": "Target any worksheet by name, or let the connector default to the first sheet — no changes needed to your process model when sheet names are predictable.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6627446",
      "refId": "1d99eced-8fa8-4275-9f09-4e965bf3ac17",
      "header": "Control how empty cells appear in output",
      "description": "Control how blank cells and empty rows appear in output: return them as null, as empty strings, or exclude them entirely — keeping downstream logic clean without extra mapping steps.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6627447",
      "refId": "efa8b985-be5d-4558-aa18-4583387b44c7",
      "header": "Convert cell values automatically",
      "description": "Cell values are converted automatically: integers, decimals, booleans, dates (as ISO 8601 strings), and formula results all map to the correct JSON types — no manual parsing required.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6627448",
      "refId": "f25028d0-f4ed-4b53-8dea-feb82090b3ca",
      "header": "Map results directly to process variables",
      "description": "Feed results straight into your BPMN flow via a named result variable or a FEEL expression, making spreadsheet data immediately available to downstream tasks and gateways.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6627449",
      "refId": "6bdae401-c848-4df5-9838-7de47ffe84c3",
      "header": "Load Excel files from multiple sources",
      "description": "Load Excel files via a Camunda Document Reference to handle files uploaded directly to a running process (such as email attachments) or from a public URL for quick testing.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
