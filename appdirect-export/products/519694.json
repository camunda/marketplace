  "features": [
    {
      "id": "6246496",
      "refId": "f5dfb673-3032-4929-aa05-5984854e6f46",
      "header": "Structured project kick-off and scope alignment",
      "description": "Start with clear scope definition, system access, and source code validation. The kick-off phase ensures alignment between business, IT, and governance for a migration without surprises.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6246497",
      "refId": "a024302c-0b92-472b-bba4-3705ad963dee",
      "header": "End-to-end architecture and process assessment",
      "description": "We analyze your architecture and business processes to define a Camunda 8-ready blueprint. This includes identifying embedded versus remote setups and required technology changes.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6246498",
      "refId": "b36b26b3-ff27-4b7f-99e7-98bffaccf039",
      "header": "Guided transition to Camunda 8 runtime",
      "description": "In the implementation phase, we migrate core process components, including job workers, service tasks, and infrastructure. From Zeebe setup to DMN updates and testing, we handle the technical shift end-to-end.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6246499",
      "refId": "dc82f8f5-da23-420d-9412-80b46ccdb976",
      "header": "Seamless migration of process data",
      "description": "In the data migration phase, we use the Camunda 8 Data Migrator and offer in-house exports for Camunda 7 and 8 to unify process data across systems. This enables long-term storage, compliance, and traceability in a separate, central data store.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6246500",
      "refId": "b5a9a581-61b1-42a5-a139-2f4d957d9780",
      "header": "Go-live support and final validation",
      "description": "During rollout, final tests, cutover planning, and stakeholder enablement ensure a stable production launch. We help you choose between drain-out and big-bang approaches for a clean transition.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
