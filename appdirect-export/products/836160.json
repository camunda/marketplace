  "features": [
    {
      "id": "6644017",
      "refId": "4957257c-d2bc-432c-b153-d1dca04f4b99",
      "header": "Run process orchestration on sovereign EU infrastructure",
      "description": "Run your entire Camunda 8 stack on STACKIT, a fully EU-based sovereign cloud operated under European data protection law. Keep sensitive process data, business logic, and AI workloads within European jurisdiction, with no dependency on non-EU hyperscalers. Ideal for public sector, insurance, banking, and regulated industries with strict compliance and data residency requirements.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6644018",
      "refId": "5f2ae92d-7997-4a71-8d0f-7c71dd037822",
      "header": "Use EU-hosted AI models directly in Camunda",
      "description": "Connect Camunda's AI agent connectors to STACKIT AI model serving via an OpenAI-compatible REST endpoint. Build agentic, fenAI-powered processes while keeping every inference request on sovereign European infrastructure. Combine deterministic BPMN processes with large language models without sending data to third-party providers outside the EU.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6644019",
      "refId": "00504e7b-b705-4906-b578-6307c80bb45d",
      "header": "Achieve enterprise-grade high availability and observability",
      "description": "Achieve resilient operation with Camunda distributed across STACKIT metro zones for disaster recovery, plus secure secrets handling via an external secrets operator. Full observability through Prometheus remote write lets you monitor Zeebe, Operate, and Tasklist in production from day one.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
