  "features": [
    {
      "id": "6479902",
      "refId": "deeea4f2-adcb-40de-be3f-19c65162d922",
      "header": "Orchestrate claims from start to finish",
      "description": "Coordinate the full motor insurance claim lifecycle in a single journey, from claim intake and policy validation through document checks, estimate review, repair governance, and settlement closure.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6479903",
      "refId": "ed98972f-2ff8-40a2-9e2e-0b9c12fc3c77",
      "header": "Validation assisted by IDP and AI",
      "description": "Combine IDP-based document extraction with AI-assisted risk and pricing analysis to improve validation accuracy, reduce repetitive manual checks, and provide better decision support at critical review stages.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6479904",
      "refId": "d4cd6529-c8ef-49f7-8064-f13030c93280",
      "header": "Enforce role-based human approvals",
      "description": "Add human-in-the-loop checkpoints for surveyor and product expert reviews, with clear escalation, rework, resubmission, and rejection paths to support consistent, accountable decisions.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6479905",
      "refId": "cd403ecd-64c9-4e28-9f9a-2c5f98048d73",
      "header": "Advanced milestones with messages",
      "description": "Use correlated message events to trigger real-world milestones such as survey image submission and estimate upload, enabling asynchronous progress without blocking upstream execution.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6479906",
      "refId": "7e874f8f-e3ad-41dd-a0de-30e36680b5fb",
      "header": "Handle exceptions with bounded retries",
      "description": "Apply bounded retries and defined fallback paths for validation and approval failures to prevent infinite loops and ensure every claim reaches a clear next action or terminal outcome.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
