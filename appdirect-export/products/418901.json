  "features": [
    {
      "id": "5674334",
      "refId": "86f62318-92c6-46ba-b087-35d302119215",
      "header": "Copy File",
      "description": "Automate the process of file duplication on an FTP server directly from Camunda processes. Use this feature in processes that require backup or versioning, enabling automatic file copying to designated locations.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img7617227519148893228.png",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5674335",
      "refId": "c49b0242-a522-4017-b756-e8b05be18f42",
      "header": "Copy Folder",
      "description": "For automated processes that require folder-level duplication, this feature enables you to copy entire folders on an FTP server. This feature can be used for backup or migration scenarios where the integrity of folder structures must be maintained.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img8954067499572287498.png",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5674336",
      "refId": "b24ad8ac-40a4-481e-99d4-9bf2f5803082",
      "header": "Create Folder",
      "description": "Automate folder creation on an FTP server. In processes that require new data repositories or organizational units, use this feature to create new folders as part of the automated process.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img8278113635112353733.png",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5674337",
      "refId": "83c4b87e-b793-4e01-bf4f-c007f21789b8",
      "header": "Delete File",
      "description": "Incorporate automatic file deletion into workflows. Whether you're running data-cleansing operations or need to remove temporary files, this feature allows you to delete files from an FTP server as a step in your Camunda-based processes.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img9206701316765222774.png",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5674338",
      "refId": "f56c05b0-1854-4e4b-a778-1ec8f1a964d1",
      "header": "Delete Folder",
      "description": "Automate the removal of entire folders from an FTP server. This feature is useful in scenarios such as data purging or deprovisioning, where you need to remove redundant or outdated data repositories.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img8961037570309518447.png",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "5674339",
      "refId": "84cfab47-d86f-4885-8580-e7f33d0dbe54",
      "header": "List Files",
      "description": "Retrieve a list of files from a specific directory on an FTP server within automated processes. In content audit or reporting scenarios, use this feature to generate real-time file lists for further action or review.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img67866762551764138.png",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "5674340",
      "refId": "0251f956-f2b8-4822-ba6d-486f5aba345b",
      "header": "List Folders",
      "description": "Obtain a list of folders from an FTP server directly within Camunda-powered business processes. This feature is ideal for scenarios that require a snapshot of available data repositories for tasks such as automated report generation or compliance checks.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img3704293353768725045.png",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    },
    {
      "id": "5674341",
      "refId": "3bfd730d-1375-487b-a670-6a8d70f42354",
      "header": "Move File",
      "description": "Automatically move files between folders on an FTP server. This feature is useful in automated file sorting or archiving processes where you need to organize data based on certain criteria or events.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img1388963469295048216.png",
      "hideOnOverview": false,
      "position": 8,
      "characteristics": []
    },
    {
      "id": "5674342",
      "refId": "1896f020-de5d-47c7-8dc9-f26ceea6635a",
      "header": "Move Folder",
      "description": "For processes that require folder-level organization, this feature allows you to move entire folders within an FTP server. This feature is ideal for large-scale data migration or reorganization tasks.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img3042112021226111862.png",
      "hideOnOverview": false,
      "position": 9,
      "characteristics": []
    },
    {
      "id": "5674343",
      "refId": "0715892a-3547-4524-8fcf-4000b8232683",
      "header": "Read File",
      "description": "Integrate the content of files from an FTP server directly into your Camunda processes. In data parsing or transformation tasks, use this feature to read file content for further processing or decision-making.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img1768068611306020143.png",
      "hideOnOverview": false,
      "position": 10,
      "characteristics": []
    },
    {
      "id": "5674344",
      "refId": "a8654026-653a-49bd-b781-036d01e97e03",
      "header": "Write File",
      "description": "Automatically write or append content to a file on an FTP server. Whether you're generating logs, reports, or any other kinds of files, this feature enables you to create or update files as a part of your business processes.",
      "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/418901/feature/img3061323830368583388.png",
      "hideOnOverview": false,
      "position": 11,
      "characteristics": []
    }
  ],
