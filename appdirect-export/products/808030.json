  "features": [
    {
      "id": "6524464",
      "refId": "a149fcd3-73a7-47b9-a6ef-fbc40fee471e",
      "header": "Execute quantum circuits from a BPMN service task",
      "description": "Submit quantum circuits to IBM Quantum hardware directly from a BPMN service task. Accepts circuits as OpenQASM strings or raw JSON parameters and supports both Sampler and Estimator primitives.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6524465",
      "refId": "34f77559-4093-45de-b5fa-de16309d3d87",
      "header": "Handle quantum queue times with flexible execution modes",
      "description": "Choose between blocking execution (wait for the result inline) or non-blocking polling (submit the job and check its status periodically via a BPMN timer loop) — designed to handle the unpredictable queue times of real quantum hardware.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6524466",
      "refId": "9b859d1f-b92b-47c4-9413-d61785319a90",
      "header": "Retrieve quantum job results as structured process variables",
      "description": "Retrieve the results of previously submitted quantum jobs by job ID. Enables decoupled workflows where job submission and result retrieval are separate process steps, making it easy to resume a process once a quantum job reaches a terminal state.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
