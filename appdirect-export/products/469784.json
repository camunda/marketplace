  "features": [
    {
      "id": "6320354",
      "refId": "46a79ce2-a650-4c6a-8df8-b0412da85031",
      "header": "Upload a File",
      "description": "Easily upload files from business processes to Box, enabling centralized storage and accessibility for all stakeholders involved.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6320355",
      "refId": "b60b70f0-60d5-4393-9707-a678dc00ac7c",
      "header": "Download a File",
      "description": "Retrieve files that are stored on Box and integrate them into Camunda-based processes for tasks such as approvals, reviews, and audits.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6320356",
      "refId": "e13f76d4-789d-4876-83ac-166e1c6a4caa",
      "header": "Move a File",
      "description": "Reorganize assets on Box by moving files to different folders, ensuring logical organization and streamlined file management.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6320357",
      "refId": "063254e5-49da-4dbd-b699-2c44604b1cc2",
      "header": "Create a Folder",
      "description": "Generate folders dynamically during process execution so you can categorize files on Box.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6320358",
      "refId": "eab09ec3-f6f1-4e4e-bab0-04050c6ca2c3",
      "header": "Delete a Folder",
      "description": "Automate the removal of empty or redundant folders on Box so your storage structure is optimized and clutter-free.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6320359",
      "refId": "9fc80361-be57-4fee-ad27-50a8027dc64c",
      "header": "Search for Files and Folders",
      "description": "Quickly locate specific files or folders on Box by leveraging the search functionality directly within Camunda-based processes. This feature reduces time spent manually locating critical assets.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
