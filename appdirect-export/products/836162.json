  "features": [
    {
      "id": "6644028",
      "refId": "7530596b-688d-49bb-b497-725a5b2a1688",
      "header": "Rerank retrieval hits by relevance",
      "description": "Pass vector-store hits and a query to Cohere Rerank and get back relevance-ordered documents, ready to feed an AI agent or a human review step. Positions are 1-based so they index FEEL lists directly.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6644029",
      "refId": "b0ec8dee-d0ff-49b2-a9e1-c8c3117323d1",
      "header": "Get guaranteed JSON answers",
      "description": "Provide a JSON schema and the structured output operation returns a string that is guaranteed to parse as JSON conforming to it, ideal for driving gateways and downstream automation.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6644030",
      "refId": "e870a2d2-2041-47ba-bb3a-0ab945fd991f",
      "header": "Classify text for routing",
      "description": "Give a list of allowed labels and get back exactly one, enforced through a structured-output enum at temperature 0, so a gateway condition such as cohereLabel = \"approve\" just works.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6644031",
      "refId": "f6e15453-6f51-46e5-a073-4e903b277199",
      "header": "Track token spend per instance",
      "description": "Chat operations map Cohere's billed token counts into a plain process variable, so you can aggregate cost in Camunda Optimize variable reports or explain a single instance in Camunda Operate.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6644032",
      "refId": "80770aed-20f2-4bac-a98b-5aab0cd3f557",
      "header": "Pick any model, current or future",
      "description": "Every operation offers the current Cohere lineup plus a custom model field for fine-tuned or newly released models, and a list-models utility operation shows what your API key can access.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6644033",
      "refId": "f7f60913-ec5f-40fd-8c39-c5c19f424905",
      "header": "Run anywhere with zero hosting",
      "description": "The connector is an element template on Camunda's built-in REST connector, so it works on SaaS and Self-Managed 8.5+ with no Java, no custom runtime, and secrets kept in the cluster.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
