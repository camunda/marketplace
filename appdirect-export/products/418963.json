  "features": [
    {
      "id": "6320397",
      "refId": "ad6adc2f-8d88-4e8c-9445-3d017810756e",
      "header": "Execute SOQL Query",
      "description": "Fetch specific records or data sets from your Salesforce CRM for use in process analytics, decision-making, or for driving additional workflow actions. Say goodbye to manual data pulling; automate and integrate your data retrieval seamlessly.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6320398",
      "refId": "f52b2078-0bb8-401b-af3f-23da24d8cdd6",
      "header": "Get SObject Record",
      "description": "Retrieve individual Salesforce objects such as accounts, contacts, or custom objects directly within Camunda. Ideal for situations where you need detailed information about a specific entity for process execution or auditing.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6320399",
      "refId": "f8bb8ceb-749b-437b-98f4-4e5a8dcef9b3",
      "header": "Create SObject Record",
      "description": "Add new records to Salesforce, whether it's creating a new lead, account, or any custom object. Automate the creation processes to ensure data consistency and save time.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6320400",
      "refId": "aced75a3-b816-4fb4-9c3b-2b7d0e6d8775",
      "header": "Update SObject Record:",
      "description": "Edit existing Salesforce records without leaving your Camunda environment. Automate updates to Salesforce records based on events or conditions within your Camunda processes.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6320401",
      "refId": "4347f445-e750-463f-9fc9-5876f13613db",
      "header": "Delete SObject Record",
      "description": "Remove records from Salesforce directly via Camunda, be it for data cleansing or conditional deletion based on business rules. Automate record removal to maintain data hygiene and compliance.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
