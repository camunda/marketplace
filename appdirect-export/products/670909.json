  "features": [
    {
      "id": "6584494",
      "refId": "85538495-7cfb-4491-9a0d-597006acd826",
      "header": "Advanced PDF splitting options",
      "description": "Split PDFs page-by-page, by fixed page count, by defined page ranges (e.g. 1-3, 5-7), or by top-level bookmarks. This flexibility allows precise extraction of document sections for downstream processing or classification.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6584495",
      "refId": "54ab17fd-7cf5-4d68-887d-717d489e0db3",
      "header": "File-size based splitting",
      "description": "Automatically split PDFs into chunks based on file size limits. Pages are accumulated iteratively until the threshold is reached, ensuring predictable and compliant file handling.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6584496",
      "refId": "8166e958-e799-483d-a098-28c5abb47caf",
      "header": "Effortless PDF merging",
      "description": "Combine multiple PDF files into a single, consolidated document. Perfect for assembling classified forms, bundling case documents, and preparing files for archiving or customer delivery.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6584497",
      "refId": "7ae7f91e-feff-4bcf-b0bb-4014f028ed79",
      "header": "Purpose-built for IDP and process automation",
      "description": "Ideal for intelligent document processing (IDP) scenarios where scanned documents contain multiple embedded forms. Automate the extraction, classification, and assembly steps that would otherwise require tedious manual effort.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
