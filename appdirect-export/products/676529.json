  "features": [
    {
      "id": "6419646",
      "refId": "619ac45e-f07f-413d-b278-23d2de0c73f5",
      "header": "Use ABBYY Vantage Skills in Camunda-based processes",
      "description": "The connector lets you call any ABBYY Vantage Process Skill directly from a BPMN process model. You can design the Skill in Vantage and execute it in Camunda without writing custom code. This brings powerful document AI into process automation while keeping all logic reusable and modular.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6419647",
      "refId": "a703a043-ec92-4053-8dca-569801b109aa",
      "header": "High accuracy data extraction and structured output",
      "description": "The connector enables processes to extract fields, tables, amounts, names, dates, and other structured information from complex documents using ABBYY Vantage’s Document Skills. Extracted data is returned as structured JSON or file formats through the connector and can be used for decisions, approvals, validations, and downstream integrations.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6419648",
      "refId": "f49e67de-6d86-4df2-b547-5f0747e4439a",
      "header": "Enable manual review when human input is required",
      "description": "If Vantage determines that a document needs manual verification, the connector provides access to Vantage’s Manual Review link. Camunda can pause the process, notify a user, wait for review to finish, and then continue executing the process. This enables hybrid human-in-the-loop automation with no extra integration effort.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6419649",
      "refId": "36f7f28d-6833-413d-94c3-71340e2da71a",
      "header": "Advanced business rules, matching, and validation",
      "description": "ABBYY Vantage can perform advanced validation inside the Skill such as two-way and three-way matching, field consistency checks, lookup validations, data checks, and custom business rules. When a Skill detects mismatches or rule violations, these errors are returned alongside the extracted data. This allows the process to automatically approve, escalate, or retry, based on Vantage’s built-in validation intelligence.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6419650",
      "refId": "1b4c381e-da49-4e7b-beef-245e8d66f4b4",
      "header": "Multi-document handling and classification",
      "description": "Uploaded files can contain multiple documents; for example, a PDF containing invoices, receipts, IDs, or contracts. Vantage Process Skills can split the file, classify each part, extract data for every document, and return multiple structured results. The connector delivers these outputs back to Camunda as part of the standard transaction information, enabling document routing and processing decisions for each document type.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
