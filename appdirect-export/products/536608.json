  "features": [
    {
      "id": "6319608",
      "refId": "d79498d8-62a6-4ef3-930f-c1f99f8a6b11",
      "header": "Experience-driven process orchestration",
      "description": "Design personalized user interfaces that empower individuals to seamlessly initiate and participate in your business processes, leading to streamlined workflows and truly delightful experiences.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6319609",
      "refId": "91b695c9-52e9-43dc-b6db-aa6ed0e785e7",
      "header": "Enhanced operational efficiency",
      "description": "Streamline complex, end-to-end processes that span multiple systems and departments. The connector ensures seamless data exchange between Liferay and your Camunda-driven processes, leading to improved process automation, reduced manual effort, and elimination of data silos.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6319610",
      "refId": "266d32d7-9582-4c66-a21c-ae09bf68626d",
      "header": "Unified collaborative experiences",
      "description": "Create a shared experience where your staff and external stakeholders can work collaboratively allowing you to extend your business’ digital transformation even further. By leveraging Liferay deep personalization, permissioning, and organization management capabilities you can create a shared space that facilitates dynamic, multi-party workflows.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6319611",
      "refId": "3d18f9f9-ca8f-4e07-aaa8-4eb5e61d1a34",
      "header": "Empower business users and accelerate innovation",
      "description": "With low-code/no-code capabilities of Camunda and Liferay, business users can actively participate in building and modifying collaborative processes and digital experiences.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
