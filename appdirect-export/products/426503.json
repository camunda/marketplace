  "features": [
    {
      "id": "6322722",
      "refId": "ed8637ab-d3f8-437a-b735-8f4a232d0e03",
      "header": "Send Mail",
      "description": "Automate the sending of emails directly from Camunda processes. Ideal for scenarios such as sending out customer notifications, internal communications, or automated responses. Customize emails with dynamic content based on your process data.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6322723",
      "refId": "de7780e0-7018-46bd-8caa-bc85cc037640",
      "header": "List Messages",
      "description": "Retrieve a list of emails from your Outlook account, enabling you to process or analyze them within your process. Use this feature for tracking correspondence, managing support tickets, or archiving important communications.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6322724",
      "refId": "b7200dc9-cb31-404d-be8c-2b9aecaee9b5",
      "header": "List Folders",
      "description": "Get an overview of your email folder structure directly within Camunda. This feature can help you organize email data, automate folder-based email processing, or simply keep tabs on email inbox organization.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6322725",
      "refId": "ae679f8d-9cd5-43aa-a35a-b99a902abb62",
      "header": "Create Mail Folder",
      "description": "Dynamically create new folders in your Outlook account from Camunda. Useful for categorizing emails, setting up project-specific folders, or automating inbox management based on process criteria.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
