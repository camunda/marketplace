  "features": [
    {
      "id": "5882894",
      "refId": "0a9040c8-9415-44f5-8b92-f2d7968d8ff2",
      "header": "Get Tasks from a Project",
      "description": "Retrieve all tasks within a Pega project, enabling Camunda processes to perform or complete inspection tasks.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5882895",
      "refId": "75a5d9b6-8e52-4501-9c34-c804bd8c06c0",
      "header": "Get a Task by ID",
      "description": "Fetch specific task details from Pega, allowing Camunda to perform tailored actions such as updates, notifications, and subsequent task creation.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5882896",
      "refId": "4ec2920c-1834-4eb4-b6a0-aded329c5c01",
      "header": "Create a Task",
      "description": "Directly create new tasks within a Pega Inspection Case from a Camunda process. This feature is ideal for automating project milestones or triggering sub-tasks.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5882897",
      "refId": "b70a2a76-9b7b-4fc5-9a9d-8c5795ecbe2b",
      "header": "Get Inspections",
      "description": "Enumerate all available Pega Inspections, facilitating dynamic routing or decision-making within Camunda-based processes.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "5882898",
      "refId": "a905f720-41dc-43b9-ac25-0df8580de0f9",
      "header": "Create an Inspection in Pega",
      "description": "Automatically create a new Inspection case in Pega; for example, initiate a new Fire Inspection or Safety Inspection directly from a Camunda-based process.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "5882899",
      "refId": "cbce9b01-ceea-4432-a9ac-701fe5141de1",
      "header": "Cancel a Inspection",
      "description": "Cancel an existing Inspection process in Pega. This feature allows Camunda-based processes to manage Inspection lifecycles, including their cancellation.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
