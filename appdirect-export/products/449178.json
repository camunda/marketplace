      "position": 2,
      "characteristics": []
    },
    {
      "id": "5882998",
      "refId": "554497dc-0ae9-41f2-98a3-bfa594159d90",
      "header": "Retrieve Place Details",
      "description": "Place details are the attributes associated with a place such as its name, street address, phone number, and so on. You can use these details to retrieve data about a location and use that data in your process. To retrieve place details, use a valid place ID. Then, define a list of the fields you would like with the requestedFields parameter. For example, requestedFields: [\"name\", \"categoryId\", \"address:streetAddress\"] or requestedFields: all.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
