  "features": [
    {
      "id": "6246455",
      "refId": "51d75081-41f9-4121-844b-b52bc525bfcb",
      "header": "Complete call understanding with natural language processing (NLP)",
      "description": "Unlike keyword spotting, the AI understands context, tone, intent, and sentiment.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6246456",
      "refId": "b5bb671f-6b36-4715-9f3b-a5fed554b44f",
      "header": "Drastically reduce audit time",
      "description": "Reduce overall audit cycle time, enabling 100% call coverage instead of random samples, with massive cost savings and more effective audits.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6246457",
      "refId": "c7c98a4c-1ca9-47ba-bf58-eea4066d5912",
      "header": "Automated quality scoring and compliance checks",
      "description": "Score calls against customizable criteria including script adherence, regulatory compliance, upsell attempts, and so on. Ensure consistency across auditors and reduce the risk of human error or bias.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6246458",
      "refId": "73903b1f-a5ca-4083-87f4-ee024658f8c7",
      "header": "Get real-time insights into trends",
      "description": "Identify patterns across thousands of calls, including recurring issues, agent performance trends, and missed sales opportunities. This feature empower teams to focus on continuous improvement and proactive decision-making.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6246459",
      "refId": "27666059-ba1a-43b8-bc73-0898940a503d",
      "header": "Guided coaching recommendations",
      "description": "Generates actionable feedback for agents such as “improve product knowledge” and \"missed upsell on plan upgrade.” This accelerates training and improves agent performance at scale.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
