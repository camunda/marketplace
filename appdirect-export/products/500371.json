      "position": 3,
      "characteristics": []
    },
    {
      "id": "6387017",
      "refId": "67d08afe-ecdb-4e28-a04f-05bd5462be1d",
      "header": "Leverage advanced features",
      "description": "Configure advanced OData parameters such as $filter and $select.",
