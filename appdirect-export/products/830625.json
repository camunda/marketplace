  "features": [
    {
      "id": "6635539",
      "refId": "a09f9f81-b7c8-4fe5-9108-7cfd94a2020c",
      "header": "Access the full DocuSeal API",
      "description": "Provides 21 outbound operations across Submissions, Submitters, and Templates, including creating signature requests from templates or PDF, DOCX, and HTML files, listing and archiving submissions, updating submitters, and managing templates, all with human-readable operation labels and no custom code.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6635540",
      "refId": "cde83a72-05ab-4d9b-9ffb-1efef857c125",
      "header": "React to signature events in real time",
      "description": "An inbound Form Webhook connector lets your process catch form.viewed, form.started, form.completed, and form.declined events the moment they happen, so you can move past a signature step without polling the API.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6635541",
      "refId": "d94c8e71-ceca-4fcb-a4d2-e84edc28c764",
      "header": "Correlate signatures automatically",
      "description": "The inbound and outbound connectors are pre-wired to work together: the submission ID produced by Create Submission is used automatically as the correlation key for the Form Webhook, so signature and process instance stay in sync out of the box.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6635542",
      "refId": "c7913b3c-1551-47dd-830d-7e73ae1f6c9b",
      "header": "Secure API credentials by default",
      "description": "Your DocuSeal API key is referenced as a Camunda secret rather than hardcoded, and pre-filled result expressions map every response straight into process variables you can act on immediately.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
