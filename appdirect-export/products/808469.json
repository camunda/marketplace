  "features": [
    {
      "id": "6526877",
      "refId": "65c97259-2fc5-45d7-93d4-feccf2b1d76b",
      "header": "Score up to 1,000 customers concurrently per instance",
      "description": "Provides high-performance iteration over targeted customer collections. This asynchronous pattern enables concurrent execution of risk scoring logic, ensuring efficient handling of up to 1,000 customers per instance without compromising the Camunda engine performance.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6526878",
      "refId": "852ee9dd-4a52-4ecf-8bda-0846d96ddef1",
      "header": "Classify customers automatically using a DMN decision model",
      "description": "Implements a fully executable DMN decision model to automatically classify customers. Using FEEL expressions and a first hit policy, it dynamically transforms client data (such as income and credit history) into a final risk category: premium, standard, high risk, or no profile.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6526879",
      "refId": "6bbfabf2-3352-4e72-995c-151df0defd5f",
      "header": "Adapt the review form dynamically based on scoring results",
      "description": "Includes a Camunda form that uses FEEL expressions to create a dynamic, context-aware user experience. The form presentation adapts based on the parallel iteration data and the calculated scoring result, guiding users through task-specific decisions for standard and high-risk scenarios.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
  ],
