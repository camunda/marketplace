      "description": "Enumerate all available channels to aid in decision-making or routing within orchestrated Camunda processes.",
      "hideOnOverview": false,
      "position": 8,
      "characteristics": []
    },
    {
      "id": "6320323",
      "refId": "c7f57bc5-6574-48ac-8906-df65aedfe616",
      "header": "Send Message to Channel",
      "description": "Disseminate messages to Teams channels directly from Camunda. This feature is useful for announcements, alerts, and data sharing.",
      "hideOnOverview": false,
      "position": 9,
      "characteristics": []
    },
    {
      "id": "6320324",
      "refId": "2eea1666-7d6a-4ad2-ac76-ee948eac58cb",
      "header": "Get Channel Message",
      "description": "Extract specific messages from a channel for targeted actions or data utilization in Camunda-based processes.",
      "hideOnOverview": false,
      "position": 10,
      "characteristics": []
    },
    {
