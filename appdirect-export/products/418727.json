      "refId": "2f178be3-5263-4bfd-b988-103b169d19d0",
      "header": "List Channel Messages",
      "description": "Gather a list of all messages within a channel for aggregate processing, reporting, or auditing in Camunda.",
      "hideOnOverview": false,
      "position": 11,
      "characteristics": []
