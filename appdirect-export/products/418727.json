      "id": "6320315",
      "refId": "1e92c8b5-fac7-4e39-b653-40492967af68",
      "header": "Get Chat by ID",
      "description": "Retrieve specific chat data from Teams to inform or drive subsequent activities in Camunda processes, such as condition-based branching or notifications.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6320316",
      "refId": "33faa791-b01f-4ad8-b1be-5ccdff67feda",
      "header": "List Chat Members",
      "description": "Enumerate members of a chat to establish context or permissions in orchestrated processes; for example, dynamic task assignment based on chat participants.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6320317",
      "refId": "2444c40a-eb88-4c66-9d3c-0d57acc6ebe6",
      "header": "Send Message in Chat",
      "description": "Enable Camunda to send messages in a Teams chat, be it for notifications, status updates, or data collection within a workflow.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6320318",
      "refId": "0cb51c8a-4fc7-4d67-a43c-003a1cc4d2dc",
      "header": "List Messages in Chat",
      "description": "Obtain a list of chat messages to process historical data, sentiment analysis, or compliance checks within Camunda processes.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6320319",
      "refId": "75848f0c-bc59-4338-8808-4b7fe49df30c",
      "header": "Get Message in Chat",
      "description": "Retrieve specific messages for fine-grained information extraction or context establishment in Camunda.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6320320",
      "refId": "3dd0a64a-27af-4fc6-95d0-d64f8b29d11b",
      "header": "Create Channel",
      "description": "Automatically create new Teams channels from Camunda for project-based collaborations or specialized communication streams.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "6320321",
      "refId": "c3f18113-3ccb-4597-8d4e-ef6ad43a0362",
      "header": "Get Channel",
      "description": "Fetch details of a specific Teams channel to facilitate information-driven or context-driven actions in Camunda.",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    },
    {
