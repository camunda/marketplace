  "features": [
    {
      "id": "6289805",
      "refId": "680c08e9-7e4a-403c-9f53-07bade6794bd",
      "header": "Run Camunda 7 and 8 with the same business code",
      "description": "VanillaBP enables Camunda 7 and 8 to use the same business code base. \nOnce lifted to VanillaBP, migrating from Camunda 7 to 8 is just a matter of configuration.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6289806",
      "refId": "bce8c6f6-f6f5-44ed-9dda-e00473eb65cc",
      "header": "Operate both platforms in parallel",
      "description": "Continue running Camunda 7 processes while introducing Camunda 8 processes using an adapter-based co-existence model. No need for \"big bang\" migrations.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6289807",
      "refId": "f38c1aee-25b8-4636-93b1-1f2365c6af6b",
      "header": "Migrate at the process instance level",
      "description": "Smoothly transition of workflows from Camunda 7 to 8, even across running process instances. Keep existing process instances of your application running in Camunda 7 while new instances will be created in Camunda 8.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6289808",
      "refId": "1341e219-ecc8-467c-b2c3-9f154e89e7ad",
      "header": "Simplify migration complexity",
      "description": "Abstract process logic and decouple infrastructure to avoid effects of tightly coupled legacy architecture. You will also benefit from this for upcoming changes such as the switch from gRPC to REST APIs.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
