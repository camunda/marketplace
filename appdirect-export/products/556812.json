  "features": [
    {
      "id": "6248065",
      "refId": "9d828d62-a46c-4be7-a8fb-465323e18c80",
      "header": "Comprehensive Camunda 7 Assessment & Migration Roadmap",
      "description": "We begin with a comprehensive audit of your Camunda 7 environment, encompassing processes, custom code, and integrations, to define a migration scope tailored to your technical and business requirements. Our team delivers a realistic roadmap with timelines, risk analysis, and a delivery model aligned with your goals.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6248066",
      "refId": "02cd3921-a1e4-4f38-bbb2-7a57ea03f941",
      "header": "Camunda 8 Architecture Design & Hardening",
      "description": "We design a modern, scalable Camunda 8 architecture (Kubernetes or VM-based), tailored to your security, availability, and compliance needs. This includes system hardening, observability, and disaster recovery setup — all built with financial-grade robustness in mind.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6248067",
      "refId": "88a0ae5f-6cad-40b8-bad1-1250b8c5069a",
      "header": "End-to-End Migration of Processes, Logic & APIs",
      "description": "From BPMN models to execution listeners, external clients, and custom APIs — we transform your Camunda 7 logic into Camunda 8-ready components using job-workers, FEEL, and secure, maintainable integration patterns. Tasklists and UI apps are also upgraded to match the new engine.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6248068",
      "refId": "e985c398-0e17-44bc-8351-04fec9ea9464",
      "header": "Historical Data Migration & BI Readiness",
      "description": "We help you securely migrate historical data from Camunda 7 databases into centralized or external stores. We also reconfigure reporting tools and BI platforms to support analytics from Camunda 8 datasets, ensuring compliance, traceability, and continuity of insights.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6248069",
      "refId": "42207c22-b08b-4d2d-9b69-97be5dffdd47",
      "header": "CI/CD Enablement & Delivery Automation",
      "description": "To support modern operations, we introduce DevOps practices for Camunda 8: BPMN validation, automated testing, and end-to-end deployment pipelines — enabling fast, safe, and repeatable delivery of process updates and applications.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
