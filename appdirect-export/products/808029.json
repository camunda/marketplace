  "features": [
    {
      "id": "6524459",
      "refId": "0e4c4758-61e7-46bb-96a6-7461b000764f",
      "header": "Consolidate tasks from multiple systems into one tasklist",
      "description": "KADAI’s goal is to provide a unified tasklist where all of a company’s tasks from all systems can be consolidated, controlled, and managed. Tasks are synchronized bidirectionally with the connected systems containing user tasks via KADAI’s own adapters. There is a flexible and extensible adapter architecture that allows for the integration of various systems. Camunda 8 and Camunda 7 are supported out-of-the-box.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6524460",
      "refId": "cf923e4b-0a9d-41f6-9dce-4b2dff80a519",
      "header": "Control task distribution with configurable workbaskets",
      "description": "Workbaskets can be configured with routing rules, distribution logic, and granular permissions so different teams' task inventories remain clearly separated. Sensitive areas such as VIP customer or HR cases can be restricted accordingly. KADAI includes standard routing procedures out of the box and supports full customization to meet virtually any operational requirement, including active assignment to support call center-style implementations.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6524461",
      "refId": "b3586a7b-f61f-417d-91de-c4298450a533",
      "header": "Prioritize tasks dynamically based on what matters most",
      "description": "KADAI includes standard prioritization by task and document type, with support for custom priority calculations based on any task attribute. Dynamic reprioritization periodically recalculates priorities across the task inventory so urgent work always surfaces to the right person at the right time.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6524462",
      "refId": "42770313-e7de-4600-b07d-22d3df1bf327",
      "header": "Stay informed with real-time monitoring",
      "description": "The monitoring section provides live overviews of current work status across all workbaskets, which can also feed directly into routing and distribution decisions. Configurable reports can be organized by a range of criteria to support operational review and capacity planning.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6524463",
      "refId": "9a551f58-6400-43e0-8f83-9be8244a6a93",
      "header": "Customize KADAI to match your needs",
      "description": "The solution has been designed from the beginning to be adaptable and extensible. On the one hand, this applies to the business logic, which can be tailored to individual needs through various configuration options and, in particular, through implementable Service Provider Interfaces (SPIs). On the other hand, KADAI is designed so that it can be integrated as a technical artifact into various runtime environments. This approach allows KADAI to be managed, deployed, and monitored just as one of your individual software components. One specific advantage is the easy and seamless integration into various security infrastructures.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
