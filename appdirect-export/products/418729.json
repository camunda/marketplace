      "id": "6322700",
      "refId": "db0ab8d7-5e7c-4e2a-96f7-ec41d3b435e9",
      "header": "Receive Messages",
      "description": "Enables Camunda to listen to RabbitMQ queues, allowing for real-time intake of messages that can trigger or influence subsequent process steps. This feature is particularly useful for scenarios such as order processing, task synchronization, and alerts.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6322701",
      "refId": "96853d54-c2c6-4de8-a088-896b63ac9b6e",
      "header": "Send Messages",
      "description": "Allows Camunda to publish messages to RabbitMQ queues, facilitating the initiation or modification of downstream processes in other systems. This feature is useful for orchestrating multi-system activities such as data sharing, notifications, and event-driven architecture.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    }
