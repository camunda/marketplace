  "features": [
    {
      "id": "5811031",
      "refId": "6cd67c92-a856-476b-b993-1507e11cb444",
      "header": "Updatable Timer",
      "description": "The blueprint uses an event-based gateway and message event to update the variables that the timer uses. The timer will be reevaluated after each message. This approach makes the timer updatable.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5811032",
      "refId": "247e40db-b145-4561-8ca8-24b1c79ee056",
      "header": "Visualization",
      "description": "Process designers can easily visualize the possibility of timer updates in the process model.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5811033",
      "refId": "b417d7f2-bb07-4cbf-b0d7-51312244c3f2",
      "header": "Scoping",
      "description": "Note that updating the variables for a specific process instance is only possible when the process is waiting at the event-based gateway.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    }
