  "features": [
    {
      "id": "6318177",
      "refId": "4469489d-7c30-4c5d-8c26-baf85d67f037",
      "header": "WSDL-based operation discovery",
      "description": "Automatically detect and configure available operations from a provided WSDL file, ensuring accurate integration with enterprise SOAP APIs and reducing setup time.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6318178",
      "refId": "c29a838e-4e2a-47a1-aa6e-e96957c1b77c",
      "header": "Flexible message construction",
      "description": "Easily define input payloads using XML or expressions. Populate SOAP requests with dynamic data from your Camunda process variables to match the service's expected schema.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6318179",
      "refId": "6742ffbf-75b4-49c0-962d-175221979476",
      "header": "Custom headers and namespaces",
      "description": "Add custom SOAP headers and security tokens and define XML namespaces to meet specific API requirements; ideal for working with standards-compliant enterprise services.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6318180",
      "refId": "c8be36bd-7153-4fdd-8cf0-ce3213cc7c39",
      "header": "Response mapping to variables",
      "description": "Map the SOAP response (or parts of it) directly to process variables, enabling further automation and decision-making in downstream tasks without additional parsing logic.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6318181",
      "refId": "7f3228ee-067c-4ac5-89cd-b4c43e49dc8d",
      "header": "Support for authentication",
      "description": "Configure basic authentication credentials or use custom headers for secure communication with protected SOAP endpoints.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6318182",
      "refId": "52c4b160-a9ee-4825-a5e4-240336fb4c29",
      "header": "Legacy system integration",
      "description": "Bring older, mission-critical systems into modern automation workflows without rewriting services or building middleware.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
