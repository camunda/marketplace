  "features": [
    {
      "id": "6442044",
      "refId": "99d733e5-76c3-4d95-beeb-e4ce8e502c4f",
      "header": "Decouple form and API development",
      "description": "Model forms and APIs as reusable assets in Form.io while Camunda orchestrates the end-to-end process that uses the captured data to drive automation and routing.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6442045",
      "refId": "cc05113c-fa01-42b8-a671-6390fa6138a8",
      "header": "Enterprise-ready solution pattern",
      "description": "Apply a proven approach for regulated environments by pairing Form.io's configurable data capture with Camunda's process orchestration and automation capabilities.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6442046",
      "refId": "856b0ae9-facb-404c-8952-cc414730638e",
      "header": "Connect processes to existing systems",
      "description": "Integrate modern and legacy systems so Camunda processes can read, update, and route Form.io data without creating new silos across teams and applications.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6442047",
      "refId": "345bca37-e70f-426c-aa91-a39ad7d2bb22",
      "header": "Security and governance at scale",
      "description": "Support consistent governance across forms and processes with access controls, auditing, and deployment practices that help teams manage change from development through production.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
