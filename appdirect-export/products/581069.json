  "features": [
    {
      "id": "6291981",
      "refId": "5beef992-8e61-49fd-b7e5-d7bfa1c72e6c",
      "header": "Asynchronous messaging",
      "description": "Enables decoupled execution in Camunda processes by publishing messages to MQTT topics asynchronously, preventing process delays while waiting for message handling.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6291982",
      "refId": "c7724fa5-9015-4c54-8ceb-c450e3cf335b",
      "header": "Seamless Eclipse Mosquitto integration",
      "description": "Directly connects Camunda-based business processes to Eclipse Mosquitto, providing a simple bridge for process-driven interactions with MQTT-enabled systems and devices.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6291983",
      "refId": "92200f70-5992-4c26-b5dd-a54de8d56d48",
      "header": "Customizable via BPMN",
      "description": "Allows developers to configure MQTT broker details, message payloads, QoS, and topics directly within BPMN process diagrams, giving granular, visual control within Camunda Modeler.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6291984",
      "refId": "8f4fd6be-f1d8-44ca-88ce-e2eee8781e30",
      "header": "Leverages MQTT and Mosquitto capabilities",
      "description": "Utilizes MQTT’s lightweight, publish/subscribe reliability and Mosquitto’s message persistence and offline support—ensuring robust, real-time communication and reliable delivery between Camunda and IoT or messaging environments.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
