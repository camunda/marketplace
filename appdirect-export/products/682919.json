      "id": "6509471",
      "refId": "c6277eaa-a813-4d2c-9ba8-6297e7639133",
      "header": "Connect agents to MCP tools",
      "description": "Let the agent discover and call tools exposed by MCP servers, so you can extend chat beyond Q&A to complete real tasks.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6509472",
      "refId": "08dd0e95-e1e0-4f38-91db-c52ae77aed5a",
      "header": "Add human approval for filesystem actions",
      "description": "Route filesystem tool calls through a confirmation task so a user can approve or deny execution before any file operation runs.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6509473",
      "refId": "2d3c071b-2a2a-4e14-b044-53380051bbde",
      "header": "Persist and recall important context",
      "description": "Use the OpenMemory MCP tool to save key facts during a conversation and retrieve them later for consistent follow-ups.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6509474",
      "refId": "2bead128-c3a6-4b7f-a2a9-e1906de0200f",
      "header": "Iterate until the user is satisfied",
      "description": "Capture user feedback after each agent response and loop back for follow-up prompts until the user confirms the outcome is complete.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6509475",
      "refId": "db7868a8-e150-48a4-9242-2fd11f387d4a",
      "header": "Mix local and remote tool integrations",
