  "features": [
    {
      "id": "6596000",
      "refId": "5b7595fb-c78b-4af2-928d-ad11bc82c122",
      "header": "Integrate with SAP applications using BAPI",
      "description": "Execute outbound calls to SAP Business Application Programming Interfaces (BAPIs), facilitating task execution and data integration between Camunda-powered processes and SAP systems.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6596001",
      "refId": "921f49db-f33d-4535-bfec-847400d7c1e4",
      "header": "Integrate with SAP applications using function calls",
      "description": "Execute outbound function calls to SAP, facilitating task execution and data integration between Camunda-powered processes and SAP systems.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6596002",
      "refId": "41551884-eed3-4bf2-a10f-f90581999468",
      "header": "Send and receive variables",
      "description": "Optionally include Camunda process variables in RFC calls and map the result of the call to a process variable, enabling data exchange between SAP and Camunda.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6596003",
      "refId": "610f9b47-ca89-451b-8afc-f9276e463ee9",
      "header": "Handle errors with process logic",
      "description": "Use process variables to capture errors returned by RFC calls, enabling teams to use the BPMN process modeling standard to handle business-relevant errors; for example, by designing backup flows.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
