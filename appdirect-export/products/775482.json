  "features": [
    {
      "id": "6455869",
      "refId": "0e235d8b-84f3-4b49-946b-5704687b1d5b",
      "header": "Predictive Return Analytics: ",
      "description": "ML algorithms analyze historical data, customer behavior, product images, and return codes to forecast likely returns pre-purchase, enabling better inventory planning and upstream fixes like sizing improvements.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6455870",
      "refId": "97d36b0f-8788-4fbf-b24e-8dcde8ffc4cd",
      "header": "Automated Approval & Routing:",
      "description": "AI applies predefined rules to instantly approve/deny returns (e.g., tagless items rejected), then dynamically routes via real-time optimization for speed and cost, integrating with OMS for bundling.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6455871",
      "refId": "0a62b0aa-1b54-4028-a6d6-df49859978af",
      "header": "Visual Inspection & Disposition:",
      "description": "Computer vision scans returned items for condition (wear, damage), auto-grading A/B/C for restock/refurbish/liquidate decisions, slashing manual processing 75%.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6455872",
      "refId": "bdbc9691-fc51-4c69-94de-51eb99fea6c5",
      "header": "Customer Experience Automation:",
      "description": "Self-service portals with conversational AI handle initiations/refunds/exchanges in real-time, boosting repurchase rates 2-3x.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6455873",
      "refId": "462baf56-7247-4111-af1d-864d8ce58112",
      "header": "End-to-End Workflow: ",
      "description": "Unified dashboard tracks E2E P&L by channel/SKU, feeding insights back to design teams for root-cause reductions like inconsistent sizing.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6455874",
      "refId": "9083fd2a-1e36-4c68-aadc-71492dff65d8",
      "header": "Sustainability optimization:",
      "description": "AI prioritizes circular paths (repair/recycle) via lifecycle tracking, minimizing landfill while complying with ESG via data-driven reporting.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    },
    {
      "id": "6455875",
      "refId": "1ab7158b-16e3-413c-a50d-ea0e905af051",
      "header": "Apparel-Specific, Sizing & Fit:",
      "description": "Integrates body measurement AI with purchase history to recommend sizes, reducing bracketing; enhances product pages with GenAI-generated fit visuals and descriptions.",
      "hideOnOverview": false,
      "position": 7,
      "characteristics": []
    },
    {
      "id": "6455876",
      "refId": "d79be87c-346f-4ef1-b48d-ffac0d1c4ec5",
      "header": "Apparel-Specific, Dynamic value recovery:",
      "description": "Post-inspection, AI sets optimal pricing for resale channels based on condition, demand, and market data, recovering up to 38% more value from B/C-grade items.",
      "hideOnOverview": false,
      "position": 8,
      "characteristics": []
    },
    {
      "id": "6455877",
      "refId": "ad137f0e-c439-4384-98dc-4c7592e2aea4",
      "header": "Apparel-Specific, Fraud & Anomaly Detection:",
      "description": "ML flags wardrobing or suspicious patterns (e.g., repeat returns), with agentic escalation for verification, cutting fraud losses significantly.",
      "hideOnOverview": false,
      "position": 9,
      "characteristics": []
    }
  ],
