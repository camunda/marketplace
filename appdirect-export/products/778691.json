  "features": [
    {
      "id": "6459309",
      "refId": "42b61625-04ef-4642-be59-222f028eb237",
      "header": " AI-Powered Patient Discharge to Claim Processing",
      "description": "Automates the complete workflow from patient discharge through insurance claim submission and payment using AWS Bedrock (Mistral 7B). Each step — discharge validation, claim preparation, submission, and payment processing —\n  uses dynamically generated AI prompts with full healthcare context including ICD-10 codes, CPT codes, and DRG classifications.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6459310",
      "refId": "847c3a30-60c5-49c7-89af-fcdd98eb428b",
      "header": "Emergency Department Workflow with Intelligent Triage",
      "description": "Manages the full ED workflow including patient registration, vital signs assessment, AI-powered symptom analysis and triage scoring, automated diagnostic ordering based on protocols, real-time resource reservation for rooms\n  and equipment, and multi-channel specialist notifications with automatic escalation.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6459311",
      "refId": "008cb4ba-812b-46c8-a336-d903cd737a5f",
      "header": "Agentic AI Prior Authorization",
      "description": "An autonomous AI agent system that handles prior authorization screening and submission with goal-oriented planning, self-directed execution, confidence-based decision-making, and a learning mechanism that extracts patterns\n  from past outcomes to improve future decisions.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6459312",
      "refId": "944be3b4-aab7-419d-88a9-d9f53e5fde75",
      "header": "AI-Optimized Nurse Scheduling",
      "description": "Uses AWS Bedrock to analyze historical staffing data, patient acuity levels, and nurse skills to generate optimized shift schedules. Includes Redis-based real-time shift management, cost estimation, and workload balancing\n  across departments.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6459313",
      "refId": "480fb060-ba46-45c3-9e24-bbc95f451d22",
      "header": " Real-Time Resource Management",
      "description": "Dynamic room, equipment, and staff reservation powered by Redis caching and AI-driven conflict resolution. Includes predictive demand forecasting over a 4-hour window with multi-factor optimization targeting 85%+ utilization\n  across departments.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    }
  ],
