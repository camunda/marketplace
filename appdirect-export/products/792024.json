  },
  "overview": {
    "splashTitle": "Automate multi-channel communications with Brevo",
    "splashDescription": "The Brevo Notification connector enables Camunda-based business processes to send real-time notifications using the Brevo API. It supports email, SMS, and WhatsApp messaging, allowing seamless communication directly from business processes. There is no need to use connectors separately—this single connector can handle all notification types (email, SMS, and WhatsApp), simplifying implementation and reducing complexity. With dynamic routing based on notification type, this connector simplifies integration with Brevo and helps automate customer communication, alerts, and transactional messaging within processes.",
    "imageUrl": "https://d3bql97l1ytoxn.cloudfront.net/app_resources/792024/overview/img3111837220763978725.png?623dc09cb1981a6e2df9c1d3890b91f9",
