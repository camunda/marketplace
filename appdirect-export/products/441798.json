  "features": [
    {
      "id": "5815053",
      "refId": "c1b465b9-87be-4ab0-a6eb-fa191e0f2931",
      "header": "Start New Robot",
      "description": "This function allows you to queue tasks for an RPA bot. After the bot initiates the process, it returns the process ID to Camunda, allowing the process to track the bot's status and receive the data it produces.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "5815054",
      "refId": "41fc7ed0-b1a3-419d-9749-d3e3a969563f",
      "header": "Get Robot Status",
      "description": "Use the Get Status feature to monitor the current status of RPA tasks directly from your Camunda process. This functionality provides real-time updates, enabling informed decision-making, effective error management, and the initiation of follow-up actions for seamless business operations.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "5815055",
      "refId": "a501b353-5488-419e-9467-7353ffab14ad",
      "header": "Get DataStore",
      "description": "Use the Get DataStore function to retrieve information about a datastore using its mnemonic. This feature allows you to access detailed information about the specified datastore, facilitating efficient data management and retrieval within your processes.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "5815056",
      "refId": "46adcf15-d097-449c-acdd-2a43be179ba1",
      "header": "Get item from DataStore",
      "description": "Use the Get item from DataStore function to locate data produced by the robot and stored in the datastore by file name. This feature allows you to quickly retrieve and use information generated by your RPA bots based on the specified file name.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
