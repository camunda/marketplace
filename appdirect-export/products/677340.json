  "features": [
    {
      "id": "6422692",
      "refId": "f4bca3cf-f773-4995-885e-6fde3e18d548",
      "header": "Multi-Channel Message Ingestion",
      "description": "Receives and processes messages from WhatsApp Business API, Telegram Bot API, and GCC SMS providers including Unifonic, Infobip, STC, and Etisalat.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6422693",
      "refId": "eec828a8-771b-4f87-9809-dd1f52c2849a",
      "header": "Arabic Language Normalization",
      "description": "Normalizes diacritics, tatweel, hamza variants, and Eastern Arabic numerals to ensure accurate routing and workflow automation.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6422694",
      "refId": "eaa1cf05-630e-432a-aa96-caa30fa4e462",
      "header": "Process Instantiation & Message Correlation",
      "description": "Starts new BPMN process instances or correlates follow-up messages to existing workflows using correlation keys and routing rules.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6422695",
      "refId": "350ec99e-f3b7-4056-8872-9fe7074c4152",
      "header": "Unified Message Model",
      "description": "Converts incoming channel-specific payloads into a consistent InboundMessage structure for predictable automation behavior.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6422696",
      "refId": "91ba001d-f081-481e-bea0-49c7eb1d41fd",
      "header": "Attachment Handling",
      "description": "Downloads and stores images, PDFs, and media files to Local Storage, MinIO, or AWS S3.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6422697",
      "refId": "3c6a7f9f-8fe3-4c38-a4a6-772fd941ca41",
      "header": "Session State Tracking",
      "description": "Maintains conversational state across messages to support multi-step chat-driven workflows.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
