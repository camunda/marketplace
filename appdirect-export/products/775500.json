  "features": [
    {
      "id": "6457147",
      "refId": "fb4a9442-12aa-4418-896f-40a12b44f8f3",
      "header": "Scope & Migration Readiness ",
      "description": "We assess your existing processes, integrations, and operational constraints to establish a clear migration baseline. Based on this, we define a realistic and transparent migration scope that aligns with your technical and organizational goals.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6457148",
      "refId": "6b2e1718-22fd-4f05-aaa8-d2f388b47f7a",
      "header": "Review & Planning",
      "description": "We review your current technology stack and target architecture to design a tailored migration plan. Architectural and conceptual differences between Camunda 7 and Camunda 8 are explicitly considered to avoid surprises during implementation. ",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6457149",
      "refId": "c01bfba2-993e-4313-874e-4d62d1c242e4",
      "header": "Application & Data Migration",
      "description": "We migrate process models and application code using a test-driven approach supported by automated migration tooling. Clean refactoring and solid test coverage ensure functional parity while enabling the adoption of Camunda 8 concepts where appropriate. Depending on your requirements, we support both drain-out and big-bang data migration strategies.\n",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6457150",
      "refId": "33b2e6bd-69a0-4055-a99c-2f2021791bda",
      "header": "Testing & Validation",
      "description": "We systematically test and validate migrated processes and applications to ensure correctness, performance, and operational stability in the Camunda 8 environment.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    }
  ],
