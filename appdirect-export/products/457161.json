  "features": [
    {
      "id": "6418277",
      "refId": "033bee49-8c64-4f4b-901e-2d0c418ec4b4",
      "header": "List Emails",
      "description": "Retrieve and view a list of emails in specific folders or across an entire mailbox using POP3 or IMAP. This function offers a clear and concise summary of email contents which can be used for quick oversight or to trigger subsequent process tasks in Camunda.",
      "hideOnOverview": false,
      "position": 1,
      "characteristics": []
    },
    {
      "id": "6418278",
      "refId": "9f26b6d1-5ed6-40ad-b75f-42d96f8a66bb",
      "header": "Read Emails",
      "description": "Read and extract data from emails, including header information and body, using POP3 or IMAP. This feature is essential for processes that require content analysis or automated processing based on the information contained within emails.",
      "hideOnOverview": false,
      "position": 2,
      "characteristics": []
    },
    {
      "id": "6418279",
      "refId": "aab3a521-b2db-4004-a7f5-a4e55b51c2b1",
      "header": "Advanced Email Search",
      "description": "Perform complex searches with detailed criteria such as sender, recipient, subject, keywords, and date ranges. This powerful search capability ensures that specific emails can be quickly located and acted upon within a Camunda-based process.",
      "hideOnOverview": false,
      "position": 3,
      "characteristics": []
    },
    {
      "id": "6418280",
      "refId": "507c6dd5-85c0-4da0-af94-9b86f73e0163",
      "header": "Send Email",
      "description": "Create outbound emails directly from Camunda-based processes using SMTP. Customize various aspects of the email, such as recipients, subject lines, and body content, facilitating communication.",
      "hideOnOverview": false,
      "position": 4,
      "characteristics": []
    },
    {
      "id": "6418281",
      "refId": "b41a4d39-def2-4d9e-b506-57c9ea8e7c2e",
      "header": "Delete Email",
      "description": "Delete emails from a mailbox using POP3 or IMAP. Use this function to manage inbox size, maintain organization, and ensure compliance with data retention policies. This feature can be automated within business processes to keep email communications streamlined and relevant.",
      "hideOnOverview": false,
      "position": 5,
      "characteristics": []
    },
    {
      "id": "6418282",
      "refId": "15ce661e-0235-47d8-ae22-380a24be722f",
      "header": "Move Emails",
      "description": "Move emails between folders using the IMAP protocol, allowing for efficient inbox organization. This feature supports automated categorization and prioritization of emails, ensuring that the mailbox remains orderly and that important emails are readily accessible within a process.",
      "hideOnOverview": false,
      "position": 6,
      "characteristics": []
    }
  ],
